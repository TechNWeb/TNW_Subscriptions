<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.cart.form" template="TNW_Subscriptions::cart/form.phtml" >
            <arguments>
                <argument xsi:type="object" name="groups_view_model">TNW\Subscriptions\Block\Cart\Groups</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="checkout.cart.item.renderers.default" template="TNW_Subscriptions::cart/item/default.phtml">
            <arguments>
                <argument xsi:type="object" name="groups_view_model">TNW\Subscriptions\Block\Cart\Groups</argument>
            </arguments>
            <block name="checkout.cart.item.renderers.default.subscribe" as="subscribe-renderer" class="TNW\Subscriptions\Block\Product\View\Subscribe" template="TNW_Subscriptions::cart/item/subscribe.phtml" ifconfig="tnw_subscriptions_general/general/allow_edit_cart"/>
        </referenceBlock>
        <referenceBlock name="checkout.cart.item.renderers.simple" template="TNW_Subscriptions::cart/item/default.phtml">
            <arguments>
                <argument xsi:type="object" name="groups_view_model">TNW\Subscriptions\Block\Cart\Groups</argument>
            </arguments>
            <block name="checkout.cart.item.renderers.simple.subscribe" as="subscribe-renderer" class="TNW\Subscriptions\Block\Product\View\Subscribe" template="TNW_Subscriptions::cart/item/subscribe.phtml" ifconfig="tnw_subscriptions_general/general/allow_edit_cart"/>
        </referenceBlock>
        <referenceBlock name="checkout.cart.item.renderers.virtual" template="TNW_Subscriptions::cart/item/default.phtml">
            <arguments>
                <argument xsi:type="object" name="groups_view_model">TNW\Subscriptions\Block\Cart\Groups</argument>
            </arguments>
            <block name="checkout.cart.item.renderers.virtual.subscribe" as="subscribe-renderer" class="TNW\Subscriptions\Block\Product\View\Subscribe" template="TNW_Subscriptions::cart/item/subscribe.phtml" ifconfig="tnw_subscriptions_general/general/allow_edit_cart"/>
        </referenceBlock>
        <referenceBlock name="checkout.cart.item.renderers.downloadable" template="TNW_Subscriptions::cart/item/default.phtml">
            <arguments>
                <argument xsi:type="object" name="groups_view_model">TNW\Subscriptions\Block\Cart\Groups</argument>
            </arguments>
            <block name="checkout.cart.item.renderers.downloadable.subscribe" as="subscribe-renderer" class="TNW\Subscriptions\Block\Product\View\Subscribe" template="TNW_Subscriptions::cart/item/subscribe.phtml" ifconfig="tnw_subscriptions_general/general/allow_edit_cart"/>
        </referenceBlock>
        <referenceBlock name="checkout.cart.item.renderers.configurable" template="TNW_Subscriptions::cart/item/default.phtml">
            <arguments>
                <argument xsi:type="object" name="groups_view_model">TNW\Subscriptions\Block\Cart\Groups</argument>
            </arguments>
            <block name="checkout.cart.item.renderers.configurable.subscribe" as="subscribe-renderer" class="TNW\Subscriptions\Block\Product\View\Subscribe" template="TNW_Subscriptions::cart/item/subscribe.phtml" ifconfig="tnw_subscriptions_general/general/allow_edit_cart"/>
        </referenceBlock>
        <referenceBlock name="checkout.cart.item.renderers.grouped" template="TNW_Subscriptions::cart/item/default.phtml">
            <arguments>
                <argument xsi:type="object" name="groups_view_model">TNW\Subscriptions\Block\Cart\Groups</argument>
            </arguments>
            <block name="checkout.cart.item.renderers.grouped.subscribe" as="subscribe-renderer" class="TNW\Subscriptions\Block\Product\View\Subscribe" template="TNW_Subscriptions::cart/item/subscribe.phtml" ifconfig="tnw_subscriptions_general/general/allow_edit_cart"/>
        </referenceBlock>
        <referenceBlock name="checkout.cart.totals">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="block-totals" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="initial_fee" xsi:type="array">
                                    <item name="component" xsi:type="string">TNW_Subscriptions/js/checkout/cart/totals/initial-fee</item>
                                    <item name="sortOrder" xsi:type="string">20</item>
                                    <item name="config" xsi:type="array">
                                        <item name="template" xsi:type="string">TNW_Subscriptions/checkout/cart/totals/initial-fee</item>
                                        <item name="title" translate="true" xsi:type="string">Initial Fee</item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>

<?xml version="1.0" ?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">tnw_subscriptionprofile_edit_additional_form.tnw_subscriptionprofile_edit_additional_form_data_source</item>
            <item name="deps" xsi:type="string">tnw_subscriptionprofile_edit_additional_form.tnw_subscriptionprofile_edit_additional_form_data_source</item>
            <item name="namespace" xsi:type="string">tnw_subscriptionprofile_edit_additional_form</item>
        </item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="ajaxSave" xsi:type="boolean">true</item>
            <item name="ajaxSaveType" xsi:type="string">simple</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
        <item name="buttons" xsi:type="array">
            <item name="save" xsi:type="array">
                <item name="name" xsi:type="string">save</item>
                <item name="label" xsi:type="string" translate="true">Save</item>
                <item name="class" xsi:type="string">save primary</item>
            </item>
        </item>
    </argument>
    <dataSource name="tnw_subscriptionprofile_edit_additional_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">TNW\Subscriptions\Model\SubscriptionProfile\AdditionalDataProvider</argument>
            <argument name="name" xsi:type="string">tnw_subscriptionprofile_edit_additional_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">profileId</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="submit_url" xsi:type="url" path="tnw_subscriptions/subscriptionprofile/additionalSave"/>
                </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
    </dataSource>
    <container name="messages">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="label" xsi:type="string"/>
                <item name="component" xsi:type="string">Magento_Catalog/js/components/messages</item>
                <item name="additionalClasses" xsi:type="string">messages</item>
            </item>
        </argument>
    </container>
    <fieldset name="additional">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="collapsible" xsi:type="boolean">false</item>
                <item name="label" translate="true" xsi:type="string">Additional Information</item>
            </item>
        </argument>
        <field name="entity_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="formElement" xsi:type="string">hidden</item>
                </item>
            </argument>
        </field>
    </fieldset>
</form>

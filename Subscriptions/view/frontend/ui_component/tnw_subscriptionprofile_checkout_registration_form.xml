<?xml version="1.0" ?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">tnw_subscriptionprofile_checkout_registration_form.tnw_subscriptionprofile_checkout_registration_form_data_source</item>
            <item name="deps" xsi:type="string">tnw_subscriptionprofile_checkout_registration_form.tnw_subscriptionprofile_checkout_registration_form_data_source</item>
        </item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="ajaxSaveType" xsi:type="string">simple</item>
            <item name="useParentLoader" xsi:type="boolean">true</item>
            <item name="parentForLoader" xsi:type="string">cart.steps</item>
            <item name="component" xsi:type="string">TNW_Subscriptions/js/components/subscriptions-form</item>
            <item name="namespace" xsi:type="string">tnw_subscriptionprofile_checkout_registration_form</item>
        </item>
        <item name="template" xsi:type="string">templates/form/subs_collapsible</item>
    </argument>
    <dataSource name="tnw_subscriptionprofile_checkout_registration_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">TNW\Subscriptions\Model\SubscriptionProfile\DataProvider\Registration</argument>
            <argument name="name" xsi:type="string">tnw_subscriptionprofile_checkout_registration_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">modify_form_data</argument>
            <argument name="requestFieldName" xsi:type="string">modify_form_data</argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
    </dataSource>
    <fieldset name="registration">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="collapsible" xsi:type="boolean">false</item>
                <item name="label" translate="true" xsi:type="boolean">false</item>
                <item name="additionalClasses" xsi:type="string">registration-fieldset</item>
                <item name="template" xsi:type="string">TNW_Subscriptions/cart/steps/registration/fieldset</item>
            </item>
        </argument>
        <container name="new_customer">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="template" xsi:type="string">TNW_Subscriptions/cart/steps/registration/new-customer</item>
                    <item name="sortOrder" xsi:type="number">1</item>
                    <item name="label" xsi:type="boolean">false</item>
                    <item name="component" xsi:type="string">TNW_Subscriptions/js/ui/cart/model/steps/registration/new-customer</item>
                </item>
            </argument>
        </container>
        <container name="existing_customer">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="template" xsi:type="string">TNW_Subscriptions/cart/steps/registration/existing-customer</item>
                    <item name="sortOrder" xsi:type="number">0</item>
                    <item name="label" xsi:type="boolean">false</item>
                    <item name="component" xsi:type="string">TNW_Subscriptions/js/ui/cart/model/steps/registration/authentication</item>
                </item>
            </argument>
        </container>
    </fieldset>
</form>


<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Api/etc/extension_attributes.xsd">
    <extension_attributes for="Magento\Quote\Api\Data\CartItemInterface">
        <attribute code="subs_initial_fees" type="TNW\Subscriptions\Model\Sales\ExtensionAttributes\QuoteItem">
            <join reference_table="tnw_subscriptions_quote_item_extension_entity" join_on_field="item_id" reference_field="item_id">
                <field>subs_initial_fee</field>
                <field>base_subs_initial_fee</field>
            </join>
        </attribute>
        <attribute code="subs_profile_item_id" type="int">
            <join reference_table="tnw_subscriptions_profile_item_sales_item" join_on_field="item_id" reference_field="quote_item_id">
                <field>profile_item_id</field>
            </join>
        </attribute>
    </extension_attributes>
    <extension_attributes for="Magento\Sales\Api\Data\OrderItemInterface">
        <attribute code="subs_initial_fees" type="TNW\Subscriptions\Model\Sales\ExtensionAttributes\OrderItem"/>
        <attribute code="subs_profile_item_id" type="int">
            <join reference_table="tnw_subscriptions_profile_item_sales_item" join_on_field="item_id" reference_field="order_item_id">
                <field>profile_item_id</field>
            </join>
        </attribute>
    </extension_attributes>
    <extension_attributes for="Magento\Sales\Api\Data\InvoiceItemInterface">
        <attribute code="subs_initial_fees" type="TNW\Subscriptions\Model\Sales\ExtensionAttributes\InvoiceItem"/>
    </extension_attributes>
    <extension_attributes for="Magento\Sales\Api\Data\CreditmemoItemInterface">
        <attribute code="subs_initial_fees" type="TNW\Subscriptions\Model\Sales\ExtensionAttributes\CreditmemoItem"/>
    </extension_attributes>
</config>

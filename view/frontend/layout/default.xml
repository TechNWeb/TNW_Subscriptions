<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="minicart">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="minicart_content" xsi:type="array">
                            <item name="config" xsi:type="array">
                                <item name="template" xsi:type="string">TNW_Subscriptions/minicart/content</item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="wishlist_sidebar" template="TNW_Subscriptions::wishlist/sidebar.phtml"/>
        <referenceBlock name="multiple-wishlist_sidebar" template="TNW_Subscriptions::wishlist/sidebar.phtml"/>
        <referenceBlock name="content">
            <block name="subs.buttons.init" template="TNW_Subscriptions::product/subs-buttons-widget.phtml" />
        </referenceBlock>
    </body>
</page>

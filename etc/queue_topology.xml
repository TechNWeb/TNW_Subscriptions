<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework-message-queue:etc/topology.xsd">
    <exchange name="tnw.products" type="topic" connection="amqp">
        <binding id="TnwLinkProductsToBillingFrequency"
                 topic="tnw.products.link"
                 destinationType="queue"
                 destination="tnw_products_link"/>
    </exchange>
    <exchange name="tnw.profit" type="topic" connection="amqp">
        <binding id="processProfitBinding"
                 topic="tnw.profile.profit"
                 destinationType="queue"
                 destination="tnw.profile.profit"/>
    </exchange>
</config>

<?xml version="1.0" ?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">tnw_subscriptionprofile_create_payment_and_billing_form.tnw_subscriptionprofile_create_payment_and_billing_form_data_source</item>
            <item name="deps" xsi:type="string">tnw_subscriptionprofile_create_payment_and_billing_form.tnw_subscriptionprofile_create_payment_and_billing_form_data_source</item>
        </item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="namespace" xsi:type="string">tnw_subscriptionprofile_create_payment_and_billing_form</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
        <item name="buttons" xsi:type="array">
            <item name="back" xsi:type="string">TNW\Subscriptions\Block\Adminhtml\SubscriptionProfile\Create\Buttons\BackButton</item>
            <item name="cancel" xsi:type="string">TNW\Subscriptions\Block\Adminhtml\SubscriptionProfile\Create\Buttons\CancelButton</item>
            <item name="save" xsi:type="string">TNW\Subscriptions\Block\Adminhtml\SubscriptionProfile\Create\Buttons\ReviewAndCreateButton</item>
        </item>
    </argument>
    <dataSource name="tnw_subscriptionprofile_create_payment_and_billing_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">TNW\Subscriptions\Model\SubscriptionProfile\DataProvider\ShippingAndBilling</argument>
            <argument name="name" xsi:type="string">tnw_subscriptionprofile_create_payment_and_billing_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="submit_url" path="*/subscriptionprofile_create/process" xsi:type="url"/>
                </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
    </dataSource>
    <fieldset name="payment_information">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="collapsible" xsi:type="boolean">false</item>
                <item name="label" xsi:type="string" translate="true">Payment Information</item>
                <item name="sortOrder" xsi:type="number">20</item>
            </item>
        </argument>
    </fieldset>
    <fieldset name="billing_information">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="collapsible" xsi:type="boolean">false</item>
                <item name="label" xsi:type="string" translate="true">Billing Information</item>
                <item name="sortOrder" xsi:type="number">30</item>
            </item>
        </argument>
        <field name="same_as_shipping">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="description" translate="true" xsi:type="string">Billing information is the same as shipping information</item>
                    <item name="formElement" xsi:type="string">checkbox</item>
                    <item name="label" xsi:type="boolean">false</item>
                    <item name="source" xsi:type="string">SubscriptionProfile</item>
                    <item name="dataScope" xsi:type="string">billing.same_as_shipping</item>
                    <item name="dataType" xsi:type="string">boolean</item>
                    <item name="valueMap" xsi:type="array">
                        <item name="true" xsi:type="number">1</item>
                        <item name="false" xsi:type="number">0</item>
                    </item>
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
        </field>
        <field name="customer_address_id">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">TNW\Subscriptions\Model\Source\CustomerAddress</item>
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="boolean">false</item>
                    <item name="formElement" xsi:type="string">select</item>
                    <item name="source" xsi:type="string">SubscriptionProfile</item>
                    <item name="dataScope" xsi:type="string">billing.customer_address_id</item>
                    <item name="imports" xsi:type="array">
                        <item name="visible" xsi:type="string">!${ $.parentName}.same_as_shipping:checked</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="review_and_create">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="title" translate="true" xsi:type="string">Review &amp; Create</item>
                    <item name="formElement" xsi:type="string">button</item>
                    <item name="component" xsi:type="string">TNW_Subscriptions/js/components/primary-button-subscription</item>
                    <item name="template" xsi:type="string">TNW_Subscriptions/form/element/primary-button</item>
                    <item name="subButtonLeft" xsi:type="string">true</item>
                </item>
            </argument>
        </field>
    </fieldset>
</form>

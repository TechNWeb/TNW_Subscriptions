                    <tr class="col-2">
                        <td class="label"><?= __('Card Number') ?></td>
                        <td class="right"><span class="text"><?= $block->getCreditCardNumber() ?></span></td>
                    </tr>
                    <tr class="col-3">
                        <td class="label"><?= __('Exp. Date') ?></td>
                        <td class="right"><span class="text"><?= $block->getCreditCardExpDate() ?></span></td>
                    </tr>

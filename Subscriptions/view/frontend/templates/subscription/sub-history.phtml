/* @var $block \TNW\Subscriptions\Block\Subscription\History */
?>
<?php $subscriptionsCollection = $block->getSubscriptionsCollection(); ?>
<?php if ($subscriptionsCollection && count($subscriptionsCollection)): ?>
    <div class="table-wrapper subscriptions-history">
        <table class="data table table-subscriptions-items history" id="my-subscriptions-table">
            <caption class="table-caption"><?php /* @escapeNotVerified */ echo __('Subscriptions') ?></caption>
            <thead>
            <tr>
                <th scope="col" class="col icon"></th>
                <th scope="col" class="col id"><?php /* @escapeNotVerified */ echo __('Subscription #') ?></th>
                <th scope="col" class="col date"><?php /* @escapeNotVerified */ echo __('Next Payment On') ?></th>
                <th scope="col" class="col status"><?php /* @escapeNotVerified */ echo __('Status') ?></th>
                <th scope="col" class="col next-payment"><?php /* @escapeNotVerified */ echo __('Next Payment') ?></th>
                <?php if ($block->canShowActionColumn()): ?>
                    <th scope="col" class="col actions"><?php /* @escapeNotVerified */ echo __('Action') ?></th>
                <?php endif;?>
            </tr>
            </thead>
            <tbody>
            <?php foreach ($subscriptionsCollection as $subscription): ?>
                <tr>
                    <td data-th="" class="sub-icons-container">
                        <?php if ($block->getIconSubClass($subscription->getStatus())): ?>
                            <div class="sub-icon tooltip-toggle <?php echo $block->getIconSubClass($subscription->getStatus()) ?>"></div>
                        <?php endif; ?>
                        <div class="sub-message tooltip-content">
                            <?php echo $block->getStatusMessage($subscription->getStatus(), $subscription->getNextBillingCycleDate()) ?>
                        </div>
                    </td>
                    <td data-th="<?php echo $block->escapeHtml(__('Subscription #')) ?>" class="col id">
                        <a href="<?php echo $block->getEditUrl($subscription) ?>">
                            <?php /* @escapeNotVerified */ echo $subscription->getLabel() ?>
                        </a>
                    </td>
                    <td data-th="<?php echo $block->escapeHtml(__('Next Payment On')) ?>" class="col date">
                        <?php /* @escapeNotVerified */ echo $block->formatDate($subscription->getNextBillingCycleDate(),\IntlDateFormatter::LONG) ?>
                    </td>
                    <td data-th="<?php echo $block->escapeHtml(__('Status')) ?>"
                        class="col status <?php echo $block->getStatusClass($subscription->getStatus())?>">
                        <?php /* @escapeNotVerified */ echo $block->getStatusLabel($subscription->getStatus()) ?>
                    </td>
                    <td data-th="<?php echo $block->escapeHtml(__('Next Payment')) ?>" class="col next-payment">
                        <?php /* @escapeNotVerified */ echo $block->formatPrice($subscription->getGrandTotal(), $subscription->getCurrencyCode()) ?>
                    </td>
                    <td data-th="<?php echo $block->escapeHtml(__('Action')) ?>" class="col actions">
                        <?php if ($block->canHoldSubscription()): ?>
                            <a href="<?php /* @escapeNotVerified */ echo $block->getHoldUrl($subscription) ?>" class="action sub-hold">
                                <span><?php /* @escapeNotVerified */ echo __('Hold') ?></span>
                            </a>
                        <?php endif; ?>
                        <?php if ($block->canCancelSubscription()): ?>
                            <a href="<?php /* @escapeNotVerified */ echo $block->getCancelUrl($subscription) ?>" class="action sub-cancel">
                                <span><?php /* @escapeNotVerified */ echo __('Cancel') ?></span>
                            </a>
                        <?php endif; ?>
                    </td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
    </div>
    <?php if ($block->getPagerHtml()): ?>
        <div class="subscriptions-products-toolbar toolbar bottom"><?php echo $block->getPagerHtml(); ?></div>
    <?php endif ?>
<?php else: ?>
    <div class="message info empty">
        <span><?php /* @escapeNotVerified */ echo __('You have placed no subscriptions.'); ?></span>
    </div>
<?php endif ?>
<?php if ($block->isSubscribeAvailable()): ?>
    <?php if ($block->IsOnlySubscribePurchase()): ?>
        <input type="hidden" name="subscribe_active" value="1" />
        <div class="addtocart-tabs" data-mage-init='{"tabs":{"openedState":"active"}}'>
            <div class="title-container">
                <div class="tab-title" data-role="collapsible" tabindex="0">
                    <a href="#subscribe-tab">
                        <?php /* @escapeNotVerified */ echo __('Subscribe') ?>
                    </a>
                </div>
            </div>
            <div class="content-container">
                <div class="tab-content subscribe-tab" id="subscribe-tab" data-role="content">
                    <?php echo $block->getChildHtml('addtocart_subscribe') ?>
                </div>
            </div>
        </div>
        <script type="text/x-magento-init">
            {
                "#product_addtocart_form": {
                    "Magento_Catalog/js/validate-product": {}
                }
            }
        </script>
    <?php elseif ($block->IsOneTimeAndSubscribePurchase()): ?>
        <input type="hidden" name="subscribe_active" value="1" />
        <div class="addtocart-tabs" data-mage-init='{"tabs":{"openedState":"active"}}'>
            <div class="title-container">
                <div class="tab-title" id="subscribe-tab-head" data-role="collapsible" tabindex="0">

<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider"
                  xsi:type="string">tnw_subscriptionprofile_index.tnw_subscriptionprofile_grid_data_source</item>
            <item name="deps" xsi:type="string">tnw_subscriptionprofile_index.tnw_subscriptionprofile_grid_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">tnw_subscriptionprofile_columns</item>
        <item name="buttons" xsi:type="array">
            <item name="add" xsi:type="string">TNW\Subscriptions\Block\Adminhtml\SubscriptionProfile\Create\Buttons\CreateProfileButton</item>
        </item>
    </argument>
    <dataSource name="tnw_subscriptionprofile_grid_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class"
                      xsi:type="string">TNW\Subscriptions\Ui\DataProvider\SubscriptionProfile\Grid</argument>
            <argument name="name" xsi:type="string">tnw_subscriptionprofile_grid_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">entity_id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/provider</item>
                    <item name="direction" xsi:type="string">DESC</item>
                    <item name="update_url" path="mui/index/render" xsi:type="url"/>
                    <item name="filter_url_params" xsi:type="array">
                        <item name="entity_id" xsi:type="string">*</item>
                        <item name="billing_frequency_id" xsi:type="string">*</item>
                        <item name="status" xsi:type="string">*</item>
                        <item name="product_id" xsi:type="string">*</item>
                        <item name="child_sku" xsi:type="string">*</item>
                    </item>
                    <item name="storageConfig" xsi:type="array">
                        <item name="indexField" xsi:type="string">entity_id</item>
                    </item>
                </item>
            </argument>
        </argument>
    </dataSource>
    <listingToolbar name="listing_top">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="sticky" xsi:type="boolean">true</item>
            </item>
        </argument>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="tnw_subscriptionprofile_columns">
        <column name="entity_id" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="visible" xsi:type="boolean">false</item>
                    <item name="filter" xsi:type="string">text</item>
                    <item name="sorting" xsi:type="string">desc</item>
                    <item name="label" translate="true" xsi:type="string">ID</item>
                </item>
            </argument>
        </column>
        <actionsColumn name="label" class="TNW\Subscriptions\Ui\Component\Listing\Column\SubscriptionProfile\Label" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">text</item>
                    <item name="label" translate="true" xsi:type="string">Label</item>
                    <item name="sortable" xsi:type="boolean">true</item>
                </item>
            </argument>
        </actionsColumn>
        <column name="thumbnail" class="TNW\Subscriptions\Ui\Component\Listing\Column\SubscriptionProfile\ProductThumbnail" component="Magento_Ui/js/grid/columns/thumbnail" sortOrder="30">
            <settings>
                <hasPreview>0</hasPreview>
                <label translate="true">Thumbnail</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="product_name" class="TNW\Subscriptions\Ui\Component\Listing\Column\SubscriptionProfile\Product" sortOrder="40" component="TNW_Subscriptions/js/grid/columns/product">
            <settings>
                <label translate="true">Product</label>
                <sortable>true</sortable>
                <filter>text</filter>
                <bodyTmpl>TNW_Subscriptions/grid/cells/product</bodyTmpl>
            </settings>
        </column>
        <column name="frequency_label" sortOrder="50">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">text</item>
                    <item name="label" translate="true" xsi:type="string">Billing frequency</item>
                </item>
            </argument>
        </column>
        <actionsColumn name="customer_id" class="TNW\Subscriptions\Ui\Component\Listing\Column\SubscriptionProfile\Customer" sortOrder="60">
            <settings>
                <label translate="true">Customer name</label>
                <sortable>true</sortable>
                <draggable>true</draggable>
                <filter>text</filter>
            </settings>
        </actionsColumn>
        <column name="customer_email" sortOrder="70">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="visible" xsi:type="boolean">false</item>
                    <item name="filter" xsi:type="string">text</item>
                    <item name="label" translate="true" xsi:type="string">Customer email</item>
                </item>
            </argument>
        </column>
        <column name="website_id" sortOrder="80">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Magento\Config\Model\Config\Source\Website</item>
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">select</item>
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/columns/select</item>
                    <item name="dataType" xsi:type="string">select</item>
                    <item name="label" translate="true" xsi:type="string">Website</item>
                </item>
            </argument>
        </column>
        <column name="status" sortOrder="90">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">TNW\Subscriptions\Ui\Component\Listing\Column\SubscriptionProfile\Status\Options</item>
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">select</item>
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/columns/select</item>
                    <item name="dataType" xsi:type="string">select</item>
                    <item name="label" translate="true" xsi:type="string">Status</item>
                </item>
            </argument>
        </column>
        <column name="start_date" class="TNW\Subscriptions\Ui\Component\Listing\Column\SubscriptionProfile\TrialEndDate" sortOrder="100">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">dateRange</item>
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/columns/date</item>
                    <item name="dataType" xsi:type="string">date</item>
                    <item name="label" xsi:type="string" translate="true">Trial end date</item>
                    <item name="dateFormat" xsi:type="string">MMMM dd, YYYY</item>
                    <item name="visible" xsi:type="boolean">false</item>
                </item>
            </argument>
        </column>
        <column name="next_billing_cycle_date" class="Magento\Ui\Component\Listing\Columns\Date" sortOrder="110">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">dateRange</item>
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/columns/date</item>
                    <item name="dataType" xsi:type="string">date</item>
                    <item name="label" xsi:type="string" translate="true">Next payment on</item>
                    <item name="dateFormat" xsi:type="string">MMMM dd, YYYY</item>
                </item>
            </argument>
        </column>
        <column name="grand_total" class="TNW\Subscriptions\Ui\Component\Listing\Column\SubscriptionProfile\Total" sortOrder="120">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Amount</item>
                    <item name="sortable" xsi:type="boolean">false</item>
                </item>
            </argument>
        </column>
        <column name="current_value" class="TNW\Subscriptions\Ui\Component\Listing\Column\SubscriptionProfile\CurrentValue" sortOrder="130">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Profit</item>
                    <item name="sortable" xsi:type="boolean">false</item>
                </item>
            </argument>
        </column>
        <column name="lifetime_value" class="TNW\Subscriptions\Ui\Component\Listing\Column\SubscriptionProfile\LifetimeValue" sortOrder="140">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Lifetime Value</item>
                    <item name="sortable" xsi:type="boolean">false</item>
                </item>
            </argument>
        </column>
        <actionsColumn class="TNW\Subscriptions\Ui\Component\Listing\Column\SubscriptionProfileActions" name="actions" sortOrder="200">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="indexField" xsi:type="string">entity_id</item>
                </item>
            </argument>
        </actionsColumn>
    </columns>
</listing>

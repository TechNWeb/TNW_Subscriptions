<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Customer:etc/sections.xsd">
    <action name="tnw_subscriptions/cart/add">
        <section name="tnw-subscriptions-subscription-cart"/>
        <section name="cart"/>
    </action>
    <action name="tnw_subscriptions/cart/delete">
        <section name="tnw-subscriptions-subscription-cart"/>
        <section name="cart"/>
    </action>
    <action name="tnw_subscriptions/cart/updatePost">
        <section name="tnw-subscriptions-subscription-cart"/>
        <section name="cart"/>
    </action>
    <action name="tnw_subscriptions/cart/updateItemOptions">
        <section name="tnw-subscriptions-subscription-cart"/>
        <section name="cart"/>
    </action>
    <action name="rest/*/V1/tnw-subscriptions-carts/*/payment-information">
        <section name="tnw-subscriptions-subscription-cart"/>
        <section name="cart"/>
        <section name="checkout-data"/>
        <section name="last-ordered-items"/>
    </action>
    <action name="rest/*/V1/guest-tnw-subscriptions-carts/*/payment-information">
        <section name="tnw-subscriptions-subscription-cart"/>
        <section name="cart"/>
        <section name="checkout-data"/>
    </action>
    <action name="rest/*/V1/carts/*/payment-information">
        <section name="tnw-subscriptions-subscription-cart"/>
    </action>
    <action name="rest/*/V1/guest-carts/*/payment-information">
        <section name="tnw-subscriptions-subscription-cart"/>
    </action>
</config>

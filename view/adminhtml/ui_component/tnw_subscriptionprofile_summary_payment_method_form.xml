<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">tnw_subscriptionprofile_summary_payment_method_form.tnw_subscriptionprofile_summary_payment_method_form_data_source</item>
            <item name="deps" xsi:type="string">tnw_subscriptionprofile_summary_payment_method_form.tnw_subscriptionprofile_summary_payment_method_form_data_source</item>
        </item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="ajaxSaveType" xsi:type="string">simple</item>
            <item name="component" xsi:type="string">TNW_Subscriptions/js/components/insert-summary-form</item>
            <item name="insertFormName" xsi:type="string">payment_method_insert_form</item>
            <item name="paymentContainer" xsi:type="string">payment_method</item>
            <item name="addPaymentValidation" xsi:type="boolean">true</item>
            <item name="namespace" xsi:type="string">tnw_subscriptionprofile_summary_payment_method_form</item>
        </item>
        <item name="template" xsi:type="string">templates/form/subs_collapsible</item>
    </argument>
    <dataSource name="tnw_subscriptionprofile_summary_payment_method_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">TNW\Subscriptions\Model\SubscriptionProfile\DataProvider\Modal\SummaryPaymentMethodForm</argument>
            <argument name="name" xsi:type="string">tnw_subscriptionprofile_summary_payment_method_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">subscription_profile_id</argument>
            <argument name="requestFieldName" xsi:type="string">subscription_profile_id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="submit_url" path="tnw_subscriptions/subscriptionprofile_edit/save" xsi:type="url"/>
                </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
    </dataSource>
    <fieldset name="payment_method">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="component" xsi:type="string">TNW_Subscriptions/js/form/editable-fieldset</item>
                <item name="collapsible" xsi:type="boolean">false</item>
                <item name="label" xsi:type="boolean">false</item>
                <item name="additionalClasses" xsi:type="string">profile__edit_block</item>
            </item>
        </argument>
        <field name="subscription_profile_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="visible" xsi:type="boolean">false</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                </item>
            </argument>
        </field>
        <container name="payment_method_header">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="template" xsi:type="string">TNW_Subscriptions/form/subscription-profile/edit/buttons</item>
                    <item name="sortOrder" xsi:type="number">0</item>
                    <item name="label" xsi:type="boolean">false</item>
                    <item name="formElement" xsi:type="string">container</item>
                    <item name="componentType" xsi:type="string">container</item>
                    <item name="content" xsi:type="string">container</item>
                </item>
            </argument>
            <field name="edit_payment_method">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="title" xsi:type="boolean">false</item>
                        <item name="elementTmpl" xsi:type="string">TNW_Subscriptions/form/element/button-additional-classes</item>
                        <item name="formElement" xsi:type="string">button</item>
                        <item name="componentType" xsi:type="string">button</item>
                        <item name="component" xsi:type="string">Magento_Ui/js/form/components/button</item>
                        <item name="displayAsLink" xsi:type="boolean">false</item>
                        <item name="sortOrder" xsi:type="number">0</item>
                        <item name="additionalClasses" xsi:type="string">profile__edit_button</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="array">
                                <item name="targetName" xsi:type="string">ns = ${ $.ns }, index = payment_method</item>
                                <item name="actionName" xsi:type="string">disablePreview</item>
                            </item>
                        </item>
                    </item>
                </argument>
            </field>
            <field name="cancel_edit_payment_method">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="title" xsi:type="boolean">false</item>
                        <item name="elementTmpl" xsi:type="string">TNW_Subscriptions/form/element/button-additional-classes</item>
                        <item name="formElement" xsi:type="string">button</item>
                        <item name="componentType" xsi:type="string">button</item>
                        <item name="component" xsi:type="string">Magento_Ui/js/form/components/button</item>
                        <item name="displayAsLink" xsi:type="boolean">false</item>
                        <item name="sortOrder" xsi:type="number">1</item>
                        <item name="additionalClasses" xsi:type="string">profile__cancel-edit_button</item>
                        <item name="imports" xsi:type="array">
                            <item name="visible" xsi:type="string">!ns = ${ $.ns }, index = payment_method:preview</item>
                        </item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="array">
                                <item name="targetName" xsi:type="string">ns = ${ $.ns }, index = payment_method</item>
                                <item name="actionName" xsi:type="string">enablePreview</item>
                            </item>
                        </item>
                    </item>
                </argument>
            </field>
        </container>
        <container name="payment_method_view">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="sortOrder" xsi:type="number">10</item>
                </item>
            </argument>
            <htmlContent name="html_content">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="imports" xsi:type="array">
                            <item name="visible" xsi:type="string">ns = ${ $.ns }, index = payment_method:preview</item>
                        </item>
                    </item>
                </argument>
                <block name="payment_method_view.block" class="TNW\Subscriptions\Block\Subscription\Summary\Payment\Details"/>
            </htmlContent>
        </container>
        <fieldset name="payment_information">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="collapsible" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="number">30</item>
                    <item name="label" xsi:type="boolean">false</item>
                    <item name="additionalClasses" xsi:type="string">sub-fieldset</item>
                    <item name="dataScope" xsi:type="string">payment</item>
                    <item name="imports" xsi:type="array">
                        <item name="visible" xsi:type="string">!ns = ${ $.ns }, index = payment_method:preview</item>
                    </item>
                </item>
            </argument>
            <field name="save">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="dataType" xsi:type="string">text</item>
                        <item name="title" translate="true" xsi:type="string">Save</item>
                        <item name="formElement" xsi:type="string">button</item>
                        <item name="component" xsi:type="string">TNW_Subscriptions/js/components/primary-button</item>
                        <item name="template" xsi:type="string">TNW_Subscriptions/form/element/primary-button</item>
                        <item name="subButtonLeft" xsi:type="string">true</item>
                        <item name="sortOrder" xsi:type="number">100</item>
                        <item name="displayPrimary" xsi:type="boolean">true</item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="array">
                                <item name="targetName" xsi:type="string">index = tnw_subscriptionprofile_summary_payment_method_form</item>
                                <item name="actionName" xsi:type="string">beforeSubmit</item>
                            </item>
                        </item>
                    </item>
                </argument>
            </field>
        </fieldset>
    </fieldset>
</form>

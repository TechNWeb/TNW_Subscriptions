<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <update handle="tnw_subscriptions_subscription_info_links"/>
    <body>
        <referenceContainer name="content">
            <block class="TNW\Subscriptions\Block\Subscription\Info\Items"
                   name="subscription.info.items"
                   after="subscription.info.links"
                   cacheable="false"
            >
                <arguments>
                    <argument name="jsLayout" xsi:type="array">
                        <item name="components" xsi:type="array">
                            <item name="products" xsi:type="array">
                                <item name="component" xsi:type="string">uiComponent</item>
                                <item name="config" xsi:type="array">
                                    <item name="template" xsi:type="string">TNW_Subscriptions/container</item>
                                </item>
                                <item name="children" xsi:type="array">
                                    <item name="products_insert_form" xsi:type="array">
                                        <item name="component" xsi:type="string">TNW_Subscriptions/js/subscription-profile/items/insert-form</item>
                                        <item name="autoRender" xsi:type="boolean">true</item>
                                        <item name="formSubmitType" xsi:type="string">ajax</item>
                                        <item name="sortOrder" xsi:type="string">0</item>
                                        <item name="externalProvider" xsi:type="string">tnw_subscriptionprofile_products_and_services_form.tnw_subscriptionprofile_products_and_services_form_data_source</item>
                                        <item name="ns" xsi:type="string">tnw_subscriptionprofile_products_and_services_form</item>
                                        <item name="label" xsi:type="boolean">false</item>
                                        <item name="config" xsi:type="array">
                                            <item name="template" xsi:type="string">TNW_Subscriptions/form/insert</item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>

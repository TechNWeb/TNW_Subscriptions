<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">tnw_billingfrequency_form.billingfrequency_form_data_source</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <label translate="true">General Information</label>
        <deps>
            <dep>tnw_billingfrequency_form.billingfrequency_form_data_source</dep>
        </deps>
        <dataScope>data</dataScope>
        <namespace>tnw_billingfrequency_form</namespace>
        <buttons>
            <button name="back" class="TNW\Subscriptions\Block\Adminhtml\BillingFrequency\Edit\BackButton"/>
            <button name="delete" class="TNW\Subscriptions\Block\Adminhtml\BillingFrequency\Edit\DeleteButton"/>
            <button name="save" class="TNW\Subscriptions\Block\Adminhtml\BillingFrequency\Edit\SaveButton"/>
            <button name="save_and_continue"
                    class="TNW\Subscriptions\Block\Adminhtml\BillingFrequency\Edit\SaveAndContinueButton"/>
        </buttons>
    </settings>
    <dataSource name="billingfrequency_form_data_source"
                component="Magento_Ui/js/form/provider">
        <settings>
            <submitUrl path="*/*/save"/>
        </settings>
        <dataProvider name="billingfrequency_form_data_source"
                      class="TNW\Subscriptions\Model\BillingFrequency\DataProvider">
            <settings>
                <primaryFieldName>id</primaryFieldName>
                <requestFieldName>id</requestFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="10">
        <settings>
            <collapsible>false</collapsible>
            <label translate="true">General Information</label>
        </settings>
        <field name="status" formElement="checkbox" sortOrder="10">
            <settings>
                <label translate="true">Enabled</label>
                <dataType>boolean</dataType>
                <dataScope>status</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <prefer>toggle</prefer>
                        <checked>true</checked>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="label" formElement="input" sortOrder="20">
            <settings>
                <label translate="true">Label</label>
                <dataScope>label</dataScope>
                <dataType>text</dataType>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <notice translate="true">This label will be shown to the end customer when they are shopping on your website for all eligible products</notice>
            </settings>
        </field>
        <field name="unit" formElement="select" sortOrder="30">
            <settings>
                <label translate="true">Unit</label>
                <dataType>text</dataType>
                <dataScope>unit</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <notice translate="true">Time unit to be used for setting up billing frequency</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="TNW\Subscriptions\Model\Config\Source\BillingFrequencyUnitType"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="frequency" component="TNW_Subscriptions/js/form/element/frequency_notice"
               formElement="input" sortOrder="40">
            <settings>
                <label translate="true">Frequency</label>
                <dataType>text</dataType>
                <dataScope>frequency</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-greater-than-zero" xsi:type="boolean">true</rule>
                </validation>
                <notice translate="true">The iteration will occur every ...</notice>
            </settings>
        </field>
    </fieldset>
    <fieldset name="linked" sortOrder="30">
        <settings>
            <label translate="true">Linked Products</label>
            <collapsible>false</collapsible>
        </settings>
        <container name="button_set" sortOrder="10" template="ui/form/components/complex">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="boolean">false</item>
                    <item name="content" xsi:type="string">Merchants are able to configure recurring options for this iteration for all linked products in the products administrative area.</item>
                </item>
            </argument>
            <button name="button_linked">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="elementTmpl" xsi:type="string">TNW_Subscriptions/form/element/button-with-tooltip</item>
                        <item name="tooltipTpl" xsi:type="string">ui/form/element/helper/tooltip</item>
                        <item name="tooltip" xsi:type="array">
                            <item name="description" xsi:type="string">New billing frequency should be saved prior to linking products</item>
                        </item>
                        <item name="actions" xsi:type="array">
                            <item name="0" xsi:type="array">
                                <item name="targetName" xsi:type="string">ns = ${ $.ns }, index = modal</item>
                                <item name="actionName" xsi:type="string">toggleModal</item>
                            </item>
                            <item name="1" xsi:type="array">
                                <item name="targetName" xsi:type="string">ns = linked_product_listing, index = linked_product_listing</item>
                                <item name="actionName" xsi:type="string">render</item>
                            </item>
                        </item>
                    </item>
                </argument>
                <settings>
                    <title translate="true">Manage Linked Products</title>
                    <disabled>true</disabled>
                    <imports>
                        <link name="disabled">!${ $.provider }:data.id</link>
                        <link name="tooltip">${ $.provider }:data.id</link>
                    </imports>
                </settings>
            </button>
        </container>
        <modal name="modal" sortOrder="50">
            <settings>
                <options>
                    <option name="title" xsi:type="string" translate="true">Manage Linked Products</option>
                    <option name="buttons" xsi:type="array">
                        <item name="0" xsi:type="array">
                            <item name="text" xsi:type="string" translate="true">Cancel</item>
                            <item name="actions" xsi:type="array">
                                <item name="0" xsi:type="string">closeModal</item>
                            </item>
                        </item>
                        <item name="1" xsi:type="array">
                            <item name="text" xsi:type="string" translate="true">Add Selected Products</item>
                            <item name="class" xsi:type="string" translate="true">action-primary</item>
                            <item name="actions" xsi:type="array">
                                <item name="0" xsi:type="array">
                                    <item name="targetName" xsi:type="string">ns = linked_product_listing, index = listing_massaction</item>
                                    <item name="actionName" xsi:type="string">triggerAdd</item>
                                </item>
                                <item name="1" xsi:type="string">closeModal</item>
                            </item>
                        </item>
                    </option>
                </options>
            </settings>
            <insertListing name="linked_product_listing">
                <settings>
                    <autoRender>false</autoRender>
                    <ns>linked_product_listing</ns>
                    <externalProvider>linked_product_listing.linked_product_listing_data_source</externalProvider>
                </settings>
            </insertListing>
        </modal>
        <insertListing name="bf_linked_products_grid" sortOrder="100">
            <settings>
                <autoRender>true</autoRender>
                <ns>tnw_billingfrequency_product_listing</ns>
                <externalProvider>tnw_billingfrequency_product_listing.tnw_billingfrequency_product_listing_data_source</externalProvider>
                <exports>
                    <link name="billing_frequency_id">${ $.externalProvider }:params.billing_frequency_id</link>
                </exports>
                <imports>
                    <link name="billing_frequency_id">${ $.provider }:data.id</link>
                </imports>
            </settings>
        </insertListing>
    </fieldset>
</form>

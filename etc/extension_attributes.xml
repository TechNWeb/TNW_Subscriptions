<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Api/etc/extension_attributes.xsd">
    <extension_attributes for="Magento\Quote\Api\Data\TotalsItemInterface">
        <attribute code="tnw_subscription_price" type="string" />
    </extension_attributes>
    <extension_attributes for="Magento\Quote\Api\Data\CartItemInterface">
        <attribute code="subs_initial_fees" type="TNW\Subscriptions\Api\Data\QuoteItemExtensionAttributesInterface">
            <join reference_table="tnw_subscriptions_quote_item_extension_entity" join_on_field="item_id" reference_field="item_id">
                <field>subs_initial_fee</field>
                <field>base_subs_initial_fee</field>
            </join>
        </attribute>
    </extension_attributes>
    <extension_attributes for="Magento\Sales\Api\Data\OrderInterface">
        <attribute code="subscription_initial_fee_refunded" type="float">
            <join reference_table="tnw_subscriptions_order_extension_entity" join_on_field="entity_id" reference_field="entity_id">
                <field>subscription_initial_fee_refunded</field>
            </join>
        </attribute>
        <attribute code="base_subscription_initial_fee_refunded" type="float">
            <join reference_table="tnw_subscriptions_order_extension_entity" join_on_field="entity_id" reference_field="entity_id">
                <field>base_subscription_initial_fee_refunded</field>
            </join>
        </attribute>
        <attribute code="subscription_paid_installment" type="string" />
        <attribute code="subscription_final_installment_date" type="string" />
        <attribute code="subscription_first_installment_date" type="string" />
        <attribute code="subscription_expire_cc" type="string" />
        <attribute code="subscription_total_static_billing_cycles" type="string" />
    </extension_attributes>
    <extension_attributes for="Magento\Sales\Api\Data\OrderItemInterface">
        <attribute code="subs_initial_fees" type="TNW\Subscriptions\Api\Data\OrderItemExtensionAttributesInterface">
            <join reference_table="tnw_subscriptions_order_item_extension_entity" join_on_field="item_id" reference_field="magento_item_id">
                <field>subs_initial_fee</field>
                <field>base_subs_initial_fee</field>
            </join>
        </attribute>
        <attribute code="proposed_shipping_date" type="string" />
    </extension_attributes>
    <extension_attributes for="Magento\Sales\Api\Data\InvoiceItemInterface">
        <attribute code="subs_initial_fees" type="TNW\Subscriptions\Api\Data\InvoiceItemExtensionAttributesInterface">
            <join reference_table="tnw_subscriptions_invoice_item_extension_entity" join_on_field="entity_id" reference_field="item_id">
                <field>subs_initial_fee</field>
                <field>base_subs_initial_fee</field>
            </join>
        </attribute>
    </extension_attributes>
    <extension_attributes for="Magento\Sales\Api\Data\CreditmemoInterface">
        <attribute code="subscription_initial_fee" type="float">
            <join reference_table="tnw_subscriptions_creditmemo_extension_entity" join_on_field="entity_id" reference_field="entity_id">
                <field>subscription_initial_fee</field>
            </join>
        </attribute>
        <attribute code="base_subscription_initial_fee" type="float">
            <join reference_table="tnw_subscriptions_creditmemo_extension_entity" join_on_field="entity_id" reference_field="entity_id">
                <field>base_subscription_initial_fee</field>
            </join>
        </attribute>
    </extension_attributes>
    <extension_attributes for="Magento\Sales\Api\Data\CreditmemoItemInterface">
        <attribute code="subs_initial_fees" type="TNW\Subscriptions\Api\Data\CreditmemoItemExtensionAttributesInterface">
            <join reference_table="tnw_subscriptions_creditmemo_item_extension_entity" join_on_field="entity_id" reference_field="item_id">
                <field>subs_initial_fee</field>
                <field>base_subs_initial_fee</field>
            </join>
        </attribute>
    </extension_attributes>
    <extension_attributes for="Magento\Catalog\Api\Data\ProductRenderInterface">
        <attribute code="subs_top_message" type="string"/>
        <attribute code="subs_trial_price" type="string"/>
        <attribute code="subs_addtocart_params" type="string"/>
        <attribute code="is_subscribe" type="boolean"/>
        <attribute code="is_subscribe_only" type="boolean"/>
        <attribute code="is_one_time_purchase" type="boolean"/>
    </extension_attributes>
</config>

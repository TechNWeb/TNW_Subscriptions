$params = $block->getParams();
$errors = !empty($params['error_messages']) ? $params['error_messages'] : [];
?>
<html>
<head>
<script>
    var require = window.top.require;
    require(['uiRegistry'], function(registry) {
        registry.get('index = <?= /* @noEscape */ $block->getData('index')?>').triggerSave(
            <?=/* @noEscape */ $this->helper(\Magento\Framework\Json\Helper\Data::class)->jsonEncode($errors); ?>
        );
    });
</script>
</head>

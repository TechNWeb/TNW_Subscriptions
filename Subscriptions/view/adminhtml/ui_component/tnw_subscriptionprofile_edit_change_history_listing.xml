<?xml version="1.0" ?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="context" xsi:type="configurableObject">
        <argument name="class" xsi:type="string">Magento\Framework\View\Element\UiComponent\Context</argument>
        <argument name="namespace" xsi:type="string">tnw_subscriptionprofile_edit_change_history_listing</argument>
    </argument>
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">tnw_subscriptionprofile_edit_change_history_listing.tnw_subscriptionprofile_edit_change_history_listing_data_source</item>
            <item name="deps" xsi:type="string">tnw_subscriptionprofile_edit_change_history_listing.tnw_subscriptionprofile_edit_change_history_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">tnw_subscriptionprofile_change_history_columns</item>
    </argument>
    <dataSource name="tnw_subscriptionprofile_edit_change_history_listing_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class"
                      xsi:type="string">TNW\Subscriptions\Ui\DataProvider\SubscriptionProfile\Form\Change\History\DataProvider</argument>
            <argument name="name" xsi:type="string">tnw_subscriptionprofile_edit_change_history_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">entity_id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/provider</item>
                    <item name="update_url" path="mui/index/render" xsi:type="url"/>
                    <item name="storageConfig" xsi:type="array">
                        <item name="indexField" xsi:type="string">entity_id</item>
                    </item>
                </item>
            </argument>
        </argument>
    </dataSource>
    <listingToolbar name="listing_top">
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="tnw_subscriptionprofile_change_history_columns">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="component" xsi:type="string">TNW_Subscriptions/js/grid/subscription-order-change-history</item>
                <item name="fieldClass" xsi:type="string">change-history-grid</item>
            </item>
        </argument>
        <column name="entity_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="visible" xsi:type="boolean">false</item>
                    <item name="sortable" xsi:type="boolean">false</item>
                    <item name="draggable" xsi:type="boolean">false</item>
                    <item name="label" xsi:type="string" translate="true">ID</item>
                </item>
            </argument>
        </column>
        <column name="comment_type">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="sortable" xsi:type="boolean">false</item>
                    <item name="draggable" xsi:type="boolean">false</item>
                    <item name="label" xsi:type="string" translate="true">Comment type</item>
                    <item name="fieldClass" xsi:type="string">comment-type</item>
                </item>
            </argument>
        </column>
        <column name="message">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="sortable" xsi:type="boolean">false</item>
                    <item name="draggable" xsi:type="boolean">false</item>
                    <item name="label" xsi:type="string" translate="true">Comment message</item>
                    <item name="fieldClass" xsi:type="string">comment-message</item>
                    <item name="bodyTmpl" xsi:type="string">ui/grid/cells/html</item>
                </item>
            </argument>
        </column>
        <column name="author">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="sortable" xsi:type="boolean">false</item>
                    <item name="draggable" xsi:type="boolean">false</item>
                    <item name="label" xsi:type="string" translate="true">Comment author</item>
                    <item name="fieldClass" xsi:type="string">comment-author</item>
                </item>
            </argument>
        </column>
        <column name="date">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="sortable" xsi:type="boolean">false</item>
                    <item name="draggable" xsi:type="boolean">false</item>
                    <item name="label" xsi:type="string" translate="true">Comment date</item>
                    <item name="fieldClass" xsi:type="string">comment-date</item>
                </item>
            </argument>
        </column>
    </columns>
</listing>

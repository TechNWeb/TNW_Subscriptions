<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider"
                  xsi:type="string">tnw_subscriptionprofile_account_index.tnw_subscriptionprofile_grid_data_source</item>
            <item name="deps" xsi:type="string">tnw_subscriptionprofile_account_index.tnw_subscriptionprofile_grid_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">tnw_subscriptionprofile_columns</item>
    </argument>
    <dataSource name="tnw_subscriptionprofile_grid_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <filterUrlParams>
                <param name="status">0,6</param>
            </filterUrlParams>
            <storageConfig>
                <param name="indexField" xsi:type="string">entity_id</param>
            </storageConfig>
            <updateUrl path="tnw_subscriptions/ui/render"/>
        </settings>
        <dataProvider name="tnw_subscriptionprofile_grid_data_source"
                      class="TNW\Subscriptions\Ui\DataProvider\SubscriptionProfile\Account\Grid">
            <settings>
                <primaryFieldName>entity_id</primaryFieldName>
                <requestFieldName>entity_id</requestFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>false</sticky>
        </settings>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <settings>
                <selectProvider>tnw_subscriptionprofile_account_index.tnw_subscriptionprofile_account_index.tnw_subscriptionprofile_columns.ids</selectProvider>
                <indexField>entity_id</indexField>
            </settings>
            <action name="delete">
                <settings>
                    <label translate="true">Change Shipping Address &amp; Method</label>
                    <type>delete</type>
                    <callback>
                        <provider>index = tnw_subscriptionprofile_account_massedit_form</provider>
                        <target>startMassEdit</target>
                    </callback>
                </settings>
            </action>
        </massaction>
    </listingToolbar>
    <columns name="tnw_subscriptionprofile_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="entity_id">
            <settings>
                <visible>false</visible>
                <filter>text</filter>
                <sorting>desc</sorting>
                <label>ID</label>
            </settings>
        </column>
        <column name="frequency_label"
                class="TNW\Subscriptions\Ui\Component\Listing\Column\SubscriptionProfile\Details"
                component="TNW_Subscriptions/js/subscription-profile/grid/column/subscription-details">
            <settings>
                <options class="TNW\Subscriptions\Ui\Component\Listing\Column\SubscriptionProfile\Frequency\Options"/>
                <bodyTmpl>TNW_Subscriptions/grid/subscription-details</bodyTmpl>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Billing frequency</label>
                <sortable>false</sortable>
                <draggable>false</draggable>
            </settings>
        </column>
        <column name="status">
            <settings>
                <fieldClass>
                    <class name="no-display">true</class>
                </fieldClass>
                <options class="TNW\Subscriptions\Ui\Component\Listing\Column\SubscriptionProfile\Status\Options"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
                <sortable>false</sortable>
                <draggable>false</draggable>
            </settings>
        </column>
        <column name="grand_total" class="TNW\Subscriptions\Ui\Component\Listing\Column\SubscriptionProfile\Total">
            <settings>
                <visible>false</visible>
                <label translate="true">Next Payment</label>
                <sortable>false</sortable>
            </settings>
        </column>
    </columns>
    <listingToolbar name="listing_bottom">
        <settings>
            <sticky>false</sticky>
        </settings>
        <paging name="listing_paging">
            <settings>
                <options>
                    <option name="10" xsi:type="array">
                        <item name="value" xsi:type="string">10</item>
                        <item name="label" xsi:type="string">10</item>
                    </option>
                    <option name="20" xsi:type="array">
                        <item name="value" xsi:type="string">20</item>
                        <item name="label" xsi:type="string">20</item>
                    </option>
                    <option name="30" xsi:type="array">
                        <item name="value" xsi:type="string">30</item>
                        <item name="label" xsi:type="string">30</item>
                    </option>
                    <option name="50" xsi:type="array">
                        <item name="value" xsi:type="string">50</item>
                        <item name="label" xsi:type="string">50</item>
                    </option>
                    <option name="100" xsi:type="array">
                        <item name="value" xsi:type="string">100</item>
                        <item name="label" xsi:type="string">100</item>
                    </option>
                </options>
                <pageSize>10</pageSize>
            </settings>
        </paging>
    </listingToolbar>
</listing>

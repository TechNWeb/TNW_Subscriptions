<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="header-wrapper">
            <block class="TNW\Subscriptions\Block\Cart\Link" name="tnw_subscriptions.cart.link" after="minicart" template="TNW_Subscriptions::cart_link.phtml">
                <arguments>
                    <argument name="jsLayout" xsi:type="array">
                        <item name="types" xsi:type="array"/>
                        <item name="components" xsi:type="array">
                            <item name="subscriptionCart" xsi:type="array">
                                <item name="component" xsi:type="string">TNW_Subscriptions/js/ui/view/cart-link</item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceContainer>

        <referenceContainer name="header-wrapper">
            <block class="Magento\Checkout\Block\Cart\Sidebar" ifconfig="tnw_subscriptions_general/general/show_magento_cart" name="minicart" as="minicart" after="logo" template="Magento_Checkout::cart/minicart.phtml"/>
        </referenceContainer>

    </body>
</page>

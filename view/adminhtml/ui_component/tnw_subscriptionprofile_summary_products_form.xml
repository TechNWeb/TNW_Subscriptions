<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">tnw_subscriptionprofile_summary_products_form.tnw_subscriptionprofile_summary_products_form_data_source</item>
            <item name="deps" xsi:type="string">tnw_subscriptionprofile_summary_products_form.tnw_subscriptionprofile_summary_products_form_data_source</item>
        </item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="ajaxSaveType" xsi:type="string">simple</item>
            <item name="component" xsi:type="string">TNW_Subscriptions/js/components/insert-summary-form</item>
            <item name="insertFormName" xsi:type="string">products_insert_form</item>
            <item name="namespace" xsi:type="string">tnw_subscriptionprofile_summary_products_form</item>
        </item>
        <item name="template" xsi:type="string">templates/form/subs_collapsible</item>
    </argument>
    <dataSource name="tnw_subscriptionprofile_summary_products_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">TNW\Subscriptions\Model\SubscriptionProfile\DataProvider\Modal\SummaryProductsForm</argument>
            <argument name="name" xsi:type="string">tnw_subscriptionprofile_summary_products_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">subscription_profile_id</argument>
            <argument name="requestFieldName" xsi:type="string">subscription_profile_id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="submit_url" path="tnw_subscriptions/subscriptionprofile_edit/save" xsi:type="url"/>
                </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
    </dataSource>
    <htmlContent name="overview_block">
        <argument name="block" xsi:type="object">TNW\Subscriptions\Block\Subscription\Summary\Overview</argument>
        <settings>
            <visible>false</visible>
        </settings>
    </htmlContent>
</form>

<?php /* @var \TNW\Subscriptions\Block\Subscription\Summary\Products $block */ ?>

<h3><?= $block->escapeHtml(__('Products')) ?></h3>
<table class="email-items">
    <thead>
        <tr>
            <th class="item-info">
                <?= $block->escapeHtml(__('Item')) ?>
            </th>
            <th class="item-info">
                <?= $block->escapeHtml(__('Details')) ?>
            </th>
            <th class="item-subscription">
                <?= $block->escapeHtml(__('Subscription Details')) ?>
            </th>
        </tr>
    </thead>
    <tbody>
    <?php if ($block->getSubscriptionProfiles()): ?>
        <?php foreach ($block->getSubscriptionProfiles() as $subscriptionProfile): ?>
            <?php $block->setSubscriptionProfile($subscriptionProfile) ?>
            <?php foreach ($block->getItems() as $item): ?>
                <tr>
                    <td class="item-info">
                        <p class="product-name"><?= $block->getName($item) ?></p>
                        <img class="product-image" src="<?= $block->getImageUrl($item) ?>" alt="<?= $block->getName($item) ?>"/>
                    </td>
                    <td class="item-additional">
                        <dl class="item-options custom-attributes">
                            <dt class="qty"><?= __('Qty') ?></dt>
                            <dd><?= (int)$item->getQty() ?></dd>
                            <?php foreach ($block->getItemOptions($item) as $option): ?>
                                <dt><?= $block->escapeHtml($option['label']) ?></dt>
                                <?php $formatedOptionValue = $block->getFormatedOptionValue($option) ?>
                                <dd>
                                    <?php if (isset($formatedOptionValue['full_view'])): ?>
                                        <?= /* @escapeNotVerified */ $formatedOptionValue['full_view'] ?>
                                    <?php else: ?>
                                        <?= /* @escapeNotVerified */ $formatedOptionValue['value'] ?>
                                    <?php endif; ?>
                                </dd>
                            <?php endforeach; ?>
                            <?php foreach ($block->customAttributes($item) as $attribute): ?>
                                <dt><?= $block->escapeHtml($attribute->getDefaultFrontendLabel()) ?></dt>
                                <dd><?= $block->escapeHtml($attribute->getFrontend()->getValue($item)) ?></dd>
                            <?php endforeach; ?>
                        </dl>
                    </td>
                    <td class="item-subscription-info">
                        <dt><?= __('Billing Frequency') ?></dt>
                        <dd><?= $block->getBillingFrequencyLabel() ?></dd>
                        <dt><?= __('Term') ?></dt>
                        <dd><?= $block->getTerm() ?></dd>
                        <dt><?= __('Start on') ?></dt>
                        <dd><?= $block->getStartOnFormatted() ?></dd>
                        <dt><?= __('Price') ?></dt>
                        <?php $taxAmount = (float) $item->getTaxAmount($subscriptionProfile) ?>
                        <dd>
                            <?= $block->formatPrice($item->getPrice() + $taxAmount) ?>
                            <?php if ($taxAmount): ?>
                                <?= '(' .  __('Incl. Tax') . ')' ?>
                            <?php endif; ?>
                        </dd>
                        <dt><?= __('Subtotal') ?></dt>
                        <dd><?= $block->getProfileFrequencyDescription() ?></dd>
                    </td>
                </tr>
            <?php endforeach; ?>
        <?php endforeach; ?>
    <?php endif; ?>
    </tbody>
</table>

<?xml version="1.0" ?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">tnw_subscriptionprofile_cancel_button_popup_form.tnw_subscriptionprofile_cancel_button_popup_form_data_source</item>
            <item name="deps" xsi:type="string">tnw_subscriptionprofile_cancel_button_popup_form.tnw_subscriptionprofile_cancel_button_popup_form_data_source</item>
        </item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="namespace" xsi:type="string">tnw_subscriptionprofile_cancel_button_popup_form</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <dataSource name="tnw_subscriptionprofile_cancel_button_popup_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">TNW\Subscriptions\Model\SubscriptionProfile\DataProvider\Modal\CancelButtonPopup</argument>
            <argument name="name" xsi:type="string">tnw_subscriptionprofile_cancel_button_popup_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">cancel_button_popup</argument>
            <argument name="requestFieldName" xsi:type="string">cancel_button_popup</argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="submit_url" path="tnw_subscriptions/subscriptionprofile/cancelsubscription" xsi:type="url"/>
            </item>
        </argument>
    </dataSource>
    <fieldset name="general" class="TNW\Subscriptions\Ui\Component\Fieldset\SubscriptionCancelButtonPopup">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="label" translate="true" xsi:type="string">Are you sure you want to cancel Subscription</item>
                <item name="component" xsi:type="string">TNW_Subscriptions/js/form/element/cancel-popup-label</item>
            </item>
        </argument>
        <field name="cancel_button_popup_title">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="template" xsi:type="string">TNW_Subscriptions/form/element/label</item>
                    <item name="text" translate="true" xsi:type="string">If subscription is canceled effective immediately, no partial refunds will be issued.</item>
                </item>
            </argument>
        </field>
        <field name="cancel_button_popup_options">
            <argument name="data" xsi:type="array">
                <item name="multiple" xsi:type="boolean">false</item>
                <item name="options" xsi:type="object">TNW\Subscriptions\Ui\DataProvider\SubscriptionProfile\Edit\CancelButtonPopupOptions</item>
                <item name="config" xsi:type="array">
                    <item name="additionalClasses" xsi:type="string">admin__field-wide</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">radioset</item>
                    <item name="template" xsi:type="string">TNW_Subscriptions/form/element/checkbox-set-with-html-label</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="cancel_button_popup_confirm">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="title" translate="true" xsi:type="string">Confirm</item>
                    <item name="formElement" xsi:type="string">button</item>
                    <item name="template" xsi:type="string">TNW_Subscriptions/form/element/cancel-popup-button</item>
                    <item name="actions" xsi:type="array">
                        <item name="0" xsi:type="array">
                            <item name="targetName" xsi:type="string">index = tnw_subscriptionprofile_cancel_button_popup_form</item>
                            <item name="actionName" xsi:type="string">save</item>
                        </item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="cancel_button_popup_change_mind">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="title" translate="true" xsi:type="string">I changed my mind</item>
                    <item name="formElement" xsi:type="string">button</item>
                    <item name="displayAsLink" xsi:type="string">true</item>
                    <item name="template" xsi:type="string">TNW_Subscriptions/form/element/link</item>
                    <item name="actions" xsi:type="array">
                        <item name="0" xsi:type="array">
                            <item name="targetName" xsi:type="string">index = cancelModal</item>
                            <item name="actionName" xsi:type="string">closeModal</item>
                        </item>
                    </item>
                </item>
            </argument>
        </field>
    </fieldset>
</form>

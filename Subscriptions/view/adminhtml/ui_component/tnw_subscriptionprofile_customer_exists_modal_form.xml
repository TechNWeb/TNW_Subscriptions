<?xml version="1.0" ?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">tnw_subscriptionprofile_customer_exists_modal_form.tnw_subscriptionprofile_customer_exists_modal_form_data_source</item>
            <item name="deps" xsi:type="string">tnw_subscriptionprofile_customer_exists_modal_form.tnw_subscriptionprofile_customer_exists_modal_form_data_source</item>
        </item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="namespace" xsi:type="string">tnw_subscriptionprofile_customer_exists_modal_form</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>

    </argument>
    <dataSource name="tnw_subscriptionprofile_customer_exists_modal_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">TNW\Subscriptions\Model\SubscriptionProfile\DataProvider\Modal\CustomerExistsForm</argument>
            <argument name="name" xsi:type="string">tnw_subscriptionprofile_customer_exists_modal_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">customer_exists_modal_form_data</argument>
            <argument name="requestFieldName" xsi:type="string">customer_exists_modal_form_data</argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
    </dataSource>
    <fieldset name="general">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="label" translate="true" xsi:type="string">Customer account already exists</item>
            </item>
        </argument>
        <field name="customer_exists_question" class="TNW\Subscriptions\Ui\Component\Field\CustomerExistsQuestion">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="template" xsi:type="string">TNW_Subscriptions/form/element/label</item>
                    <item name="component" xsi:type="string">TNW_Subscriptions/js/form/element/label</item>
                </item>
            </argument>
        </field>
        <field name="customer_exists_options">
            <argument name="data" xsi:type="array">
                <item name="multiple" xsi:type="boolean">false</item>
                <item name="options" xsi:type="object">TNW\Subscriptions\Ui\DataProvider\SubscriptionProfile\Create\CustomerExistsPopup</item>
                <item name="config" xsi:type="array">
                    <item name="additionalClasses" xsi:type="string">admin__field-wide</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">radioset</item>
                    <item name="template" xsi:type="string">TNW_Subscriptions/form/element/checkbox-set-with-html-label</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="confirm" class="TNW\Subscriptions\Ui\Component\Field\CustomerConfirmButton">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="title" translate="true" xsi:type="string">Confirm</item>
                    <item name="formElement" xsi:type="string">button</item>
                    <item name="component" xsi:type="string">TNW_Subscriptions/js/components/customer-exists-popup-confirm-button</item>
                    <item name="template" xsi:type="string">TNW_Subscriptions/form/element/primary-button</item>
                </item>
            </argument>
        </field>
    </fieldset>
</form>

<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd"
      class="TNW\Subscriptions\Ui\Component\SubscriptionProfile\Checkout\Messages">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">tnw_subscriptionprofile_checkout_messages.tnw_subscriptionprofile_checkout_messages_data_source</item>
            <item name="deps" xsi:type="string">tnw_subscriptionprofile_checkout_messages.tnw_subscriptionprofile_checkout_messages_data_source</item>
        </item>
        <item name="config" xsi:type="array">

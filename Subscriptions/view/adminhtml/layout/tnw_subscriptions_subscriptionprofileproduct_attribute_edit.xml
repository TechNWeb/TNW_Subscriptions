<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="admin-2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="left">
            <block class="TNW\Subscriptions\Block\Adminhtml\ProductSubscriptionProfile\Attribute\Edit\Tabs" name="attribute_edit_tabs">
                <container label="Main" name="main">
                    <block class="TNW\Subscriptions\Block\Adminhtml\ProductSubscriptionProfile\Attribute\Edit\Tab\Main" as="base"/>
                    <block class="Magento\Eav\Block\Adminhtml\Attribute\Edit\Options\Options" as="advanced"/>
                    <block class="TNW\Subscriptions\Block\Adminhtml\ProductSubscriptionProfile\Attribute\Edit\Tab\Advanced" as="options"/>
                </container>
            </block>
        </referenceContainer>
        <referenceContainer name="content">
            <block class="TNW\Subscriptions\Block\Adminhtml\ProductSubscriptionProfile\Attribute\Edit" name="attribute_edit_content"/>
        </referenceContainer>
        <referenceContainer name="js">
            <block class="Magento\Backend\Block\Template" name="attribute_edit_js" template="TNW_Subscriptions::profile/product/attribute/js.phtml"/>
            <block class="Magento\Backend\Block\Template" name="attribute_options_edit_js" template="TNW_Subscriptions::profile/product/attribute/options/js.phtml"/>
        </referenceContainer>
    </body>
</page>

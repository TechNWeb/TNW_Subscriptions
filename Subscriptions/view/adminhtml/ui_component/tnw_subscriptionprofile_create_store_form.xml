            <item name="save" xsi:type="string">TNW\Subscriptions\Block\Adminhtml\SubscriptionProfile\Create\Buttons\ContinueButton</item>
        </item>
    </argument>
    <dataSource name="subscriptionprofile_create_store_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">

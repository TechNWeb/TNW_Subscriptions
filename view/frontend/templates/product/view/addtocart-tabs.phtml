                    </a>
                </div>
            </div>
            <div class="content-container">
                <div class="tab-content subscribe-tab" id="subscribe-tab" data-role="content">
                    <?php echo $block->getChildHtml('addtocart_subscribe') ?>
                </div>
                <div class="tab-content" id="addtocart-tab" data-role="content" style="display:none">
                    <?php echo $block->getChildHtml('addtocart_orig') ?>
                </div>
            </div>
        </div>
    <?php else: ?>
        <input type="hidden" name="subscribe_active" value="0" />
        <?php echo $block->getChildHtml('addtocart_orig') ?>
    <?php endif ?>
<?php else: ?>
    <input type="hidden" name="subscribe_active" value="0" />
    <?php echo $block->getChildHtml('addtocart_orig') ?>
<?php endif ?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <update handle="tnw_subscriptions_subscription_info_links"/>
    <body>
        <referenceContainer name="content">
            <block class="TNW\Subscriptions\Block\Subscription\Info\Shipment"
                   name="subscription.info.shipment"
                   after="subscription.info.links"
                    template="TNW_Subscriptions::subscription/shipment.phtml">
                <block class="TNW\Subscriptions\Block\Subscription\Shipment\AddressView"
                       name="subscription.info.view.shipping.information" as="shipping-info-view"
                       template="TNW_Subscriptions::subscription_profile/summary/address.phtml">
                    <action method="setAddressType">
                        <argument name="type" xsi:type="string">shipping</argument>
                    </action>
                </block>
                <block class="TNW\Subscriptions\Block\Subscription\EditForm"
                       name="customer_address_edit_form"
                       template="TNW_Subscriptions::subscription/edit-form.phtml"
                       cacheable="false">
                    <block class="TNW\Subscriptions\Block\Subscription\Shipment\AddressEdit"
                           name="customer_address_edit"
                           template="TNW_Subscriptions::subscription/shipment/address-edit.phtml"
                           cacheable="false"/>
                </block>
                <block class="TNW\Subscriptions\Block\Subscription\Shipment\DetailsView"
                       name="subscription.info.view.shipping.details" as="shipping-details-view"
                       template="TNW_Subscriptions::subscription_profile/summary/overview/shipping-details.phtml">
                </block>
                <block class="TNW\Subscriptions\Block\Subscription\EditForm"
                       name="customer_shipping_details_edit_form"
                       template="TNW_Subscriptions::subscription/edit-form.phtml"
                       cacheable="false">
                    <action method="setFormId">
                        <argument name="type" xsi:type="string">shipping-details-form</argument>
                    </action>
                    <action method="setFormClass">
                        <argument name="type" xsi:type="string">shipping-form</argument>
                    </action>
                    <block class="TNW\Subscriptions\Block\Subscription\Shipment\DetailsEdit"
                           name="customer_shipping_details_edit"
                           template="TNW_Subscriptions::subscription/shipment/details-edit.phtml"
                           cacheable="false"/>
                </block>
            </block>
        </referenceContainer>
    </body>
</page>

<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="TNW_Subscriptions::tnw_subscriptions_root" title="TNW Subscriptions Menu"
                          sortOrder="600">
                    <resource id="TNW_Subscriptions::tnw_subscriptions_attributes" title="Custom Attributes"
                              sortOrder="200"/>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="TNW_Subscriptions::config_general" title="TNW Subscriptions Config General"
                                      sortOrder="100">
                                <resource id="TNW_Subscriptions::config_profile_options" title="TNW Subscriptions Config Profile Options"
                                          sortOrder="200"/>
                                <resource id="TNW_Subscriptions::config_product" title="TNW Subscriptions Config Product"
                                          sortOrder="300"/>
                                <resource id="TNW_Subscriptions::config_profile_notification" title="TNW Subscriptions Config Profile Options"
                                          sortOrder="400"/>
                                <resource id="TNW_Subscriptions::config_payment" title="TNW Subscriptions Payment Product"
                                          sortOrder="500"/>
                                <resource id="TNW_Subscriptions::config_customer" title="TNW Subscriptions Customer"
                                          sortOrder="600"/>
                            </resource>
                        </resource>
                    </resource>
                    <resource id="Magento_Backend::stores_attributes">
                        <resource id="TNW_Subscriptions::SubscriptionProfile_attributes" sortOrder="10" title="TNW SubscriptionProfile Attributes" />
                        <resource id="TNW_Subscriptions::ProductSubscriptionProfile_attributes" sortOrder="20" title="TNW Product SubscriptionProfile" />
                    </resource>
                </resource>
                <resource id="TNW_Subscriptions::tnw_subscriptions" title="TNW Subscriptions General Actions">
                    <resource id="TNW_Subscriptions::tnw_subscriptions_operations" title="TNW Subscriptions"
                              sortOrder="100">
                        <resource id="TNW_Subscriptions::tnw_subscriptions_subscription_profile" sortOrder="10"
                                  title="Subscription Profiles">
                            <resource id="TNW_Subscriptions::SubscriptionProfile" sortOrder="10" title="Subscription Profile"
                                      translate="title">
                                <resource id="TNW_Subscriptions::SubscriptionProfile_edit" sortOrder="10"
                                          title="Edit SubscriptionProfile"
                                          translate="title"/>
                                <resource id="TNW_Subscriptions::SubscriptionProfile_save" sortOrder="20"
                                          title="Save SubscriptionProfile"
                                          translate="title"/>
                                <resource id="TNW_Subscriptions::SubscriptionProfile_create" sortOrder="30"
                                          title="Create SubscriptionProfile"
                                          translate="title"/>
                            </resource>
                        </resource>
                        <resource id="TNW_Subscriptions::ProductSubscriptionProfile" sortOrder="10"
                                  title="Product Subscription Profile"
                                  translate="title">
                            <resource id="TNW_Subscriptions::SubscriptionProfile_create_product_save" sortOrder="30"
                                      title="Create SubscriptionProfile Product Save"
                                      translate="title"/>
                        </resource>
                    </resource>
                    <resource id="TNW_Subscriptions::tnw_subscriptions_settings" title="TNW Subscriptions Settings"
                              sortOrder="100">
                        <resource id="TNW_Subscriptions::general_config" sortOrder="20"
                                  title="TNW General Settings"/>
                        <resource id="TNW_Subscriptions::BillingFrequency" sortOrder="10" title="BillingFrequency">
                            <resource id="TNW_Subscriptions::BillingFrequency_edit" sortOrder="20"
                                      title="Edit BillingFrequency"/>
                            <resource id="TNW_Subscriptions::BillingFrequency_save" sortOrder="30"
                                      title="Save BillingFrequency"/>
                            <resource id="TNW_Subscriptions::BillingFrequency_delete" sortOrder="40"
                                      title="Delete BillingFrequency"/>
                        </resource>
                        <resource id="TNW_Subscriptions::sales_settings" sortOrder="20"
                                  title="TNW Sales Settings"/>
                        <resource id="TNW_Subscriptions::product_settings" sortOrder="30"
                                  title="TNW Product Settings"/>
                        <resource id="TNW_Subscriptions::customer_settings" sortOrder="40"
                                  title="TNW Customer Settings"/>
                    </resource>
                    <resource id="TNW_Subscriptions::tools" title="TNW Subscriptions Tools"
                              sortOrder="100">
                        <resource id="TNW_Subscriptions::tools_message" sortOrder="10" title="BillingFrequency" />
                    </resource>
                </resource>
                <resource id="Magento_Sales::sales">
                    <resource id="TNW_Subscriptions::recurring" sortOrder="10" title="TNW Recurring" />
                </resource>
                <resource id="Magento_Reports::report">
                    <resource id="TNW_Subscriptions::billing_frequencies" sortOrder="10" title="TNW Billing Frequencies">
                        <resource id="TNW_Subscriptions::report_subscribe_billing_frequency_customers" sortOrder="10" title="TNW Subscriptions By Subscribe Customers" />
                    </resource>
                    <resource id="Magento_Reports::customers">
                        <resource id="TNW_Subscriptions::report_subscribe_customer_products" sortOrder="10" title="TNW Subscriptions By Product Reports" />
                        <resource id="TNW_Subscriptions::report_subscribe_customer_billing_frequencies" sortOrder="10" title="TNW Subscriptions By Billing Frequency" />
                    </resource>
                    <resource id="Magento_Reports::salesroot">
                        <resource id="TNW_Subscriptions::report_sales_subscriptions" sortOrder="10" title="TNW Subscriptions" />
                    </resource>
                    <resource id="Magento_Reports::report_products">
                        <resource id="TNW_Subscriptions::report_subscribe_product_customers" sortOrder="10" title="TNW Subscriptions By Subscribe Customers" />
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>

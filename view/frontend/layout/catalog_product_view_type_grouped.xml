<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="product.info.form.content">
            <block name="product.info.addtocart"  as="addtocart"
                   class="TNW\Subscriptions\Block\Product\View\Subscribe"
                   template="TNW_Subscriptions::product/view/type_grouped/addtocart-tabs.phtml">
                <block class="TNW\Subscriptions\Block\Product\View\Subscribe"
                       name="product.info.addtocart.subscription" as="addtocart_subscribe"
                       template="TNW_Subscriptions::product/view/type_grouped/addtocart/subscribe.phtml"/>
                <block class="TNW\Subscriptions\Block\Product\View\Subscribe"
                       name="product.info.recurring-only" as="grouped_recurring_only"
                       template="TNW_Subscriptions::product/view/type_grouped/addtocart/recurring-only.phtml"/>
                <block class="Magento\Catalog\Block\Product\View"
                       name="product.info.addtocart.orig" as="addtocart_orig"
                       template="product/view/addtocart.phtml"/>
            </block>
        </referenceContainer>
        <move element="product.info.grouped" destination="product.info.addtocart" as="grouped_orig"/>
    </body>
</page>

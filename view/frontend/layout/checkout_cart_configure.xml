<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="catalog_product_view"/>
    <body>
        <referenceBlock name="product.info.addtocart">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">TNW_Subscriptions::product/view/addtocart-tabs.phtml</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="product.info.addtocart.additional">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">TNW_Subscriptions::product/view/addtocart-tabs.phtml</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="product.info.addtocart.subscription">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">TNW_Subscriptions::product/view/updatecart/subscribe.phtml</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="product.info.addtocart.orig">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Magento_Checkout::cart/item/configure/updatecart.phtml</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="product.info.addtocart.additional.subscription">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">TNW_Subscriptions::product/view/updatecart/subscribe.phtml</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="product.info.addtocart.additional.orig">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Magento_Checkout::cart/item/configure/updatecart.phtml</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="content">
            <block name="disableCache" cacheable="false"/>
        </referenceBlock>
        <referenceBlock name="reviews.tab" remove="true"/>
        <referenceBlock name="view.addto.compare" remove="true"/>
        <referenceBlock name="view.addto.wishlist" remove="true"/>
        <referenceBlock name="product.info.mailto" remove="true"/>
        <referenceBlock name="product.info.review" remove="true"/>
    </body>
</page>

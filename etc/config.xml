<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <tnw_subscriptions_general>
            <general>
                <active>0</active>
                <disable_cron>0</disable_cron>
            </general>
            <advanced>
                <db_log_status>1</db_log_status>
                <db_log_limit>10000</db_log_limit>
                <log_object_deep>4</log_object_deep>
            </advanced>
        </tnw_subscriptions_general>
        <tnw_subscriptions_profile_options>
            <general>
                <product_price_strategy>0</product_price_strategy>
                <shipping_fallback>2</shipping_fallback>
                <free_shipping>2</free_shipping>
                <prefix>#S</prefix>
            </general>
            <past_due_profile_options>
                <attempt_count>10</attempt_count>
                <attempt_interval>1</attempt_interval>
                <grace_period>14</grace_period>
            </past_due_profile_options>
            <emails>
                <email_identity>support</email_identity>
            </emails>
            <notifications>
                <renewals>1</renewals>
                <expired_card>1</expired_card>
            </notifications>
        </tnw_subscriptions_profile_options>
        <tnw_subscriptions_profile_notification>
            <notifications>
                <renewals>1</renewals>
                <expired_card>1</expired_card>
            </notifications>
            <send_comment_setting>
                <comment_added_enable>1</comment_added_enable>
                <comment_added>tnw_subscriptions_profile_notification_send_comment_setting_comment_added</comment_added>
                <comment_added_copy_method>bcc</comment_added_copy_method>
            </send_comment_setting>
            <status_change_setting>
                <status_change_enable>1</status_change_enable>
                <profile_status_change>tnw_subscriptions_profile_notification_status_change_setting_profile_status_change</profile_status_change>
                <status_change_copy_method>bcc</status_change_copy_method>
            </status_change_setting>
            <card_expire_setting>
                <card_expire_enable>1</card_expire_enable>
                <card_expire>tnw_subscriptions_profile_notification_card_expire_setting_card_expire</card_expire>
                <card_expire_copy_method>bcc</card_expire_copy_method>
            </card_expire_setting>
            <payment_failed_setting>
                <payment_failed_enable>1</payment_failed_enable>
                <payment_failed>tnw_subscriptions_profile_notification_payment_failed_setting_payment_failed</payment_failed>
                <payment_verification_failed>tnw_subscriptions_profile_notification_payment_failed_setting_payment_verification_failed</payment_verification_failed>
                <payment_failed_copy_method>bcc</payment_failed_copy_method>
            </payment_failed_setting>
            <renewal_setting>
                <renewal_enable>1</renewal_enable>
                <renewal>tnw_subscriptions_profile_notification_renewal_setting_renewal</renewal>
                <renewal_copy_method>bcc</renewal_copy_method>
            </renewal_setting>
            <out_of_stock_setting>
                <out_of_stock_enable>1</out_of_stock_enable>
                <out_of_stock>tnw_subscriptions_profile_notification_out_of_stock_setting_out_of_stock</out_of_stock>
                <out_of_stock_copy_method>bcc</out_of_stock_copy_method>
            </out_of_stock_setting>
        </tnw_subscriptions_profile_notification>
        <tnw_subscriptions_product>
            <general>
                <purchase_type>3</purchase_type> <!--One-Time and Recurring-->
                <start_date_type>1</start_date_type> <!--Moment of purchase-->
                <lock_product_price_status>0</lock_product_price_status> <!--Off-->
                <unlock_preset_qty_status>0</unlock_preset_qty_status> <!--Off-->
                <savings_calculation>0</savings_calculation> <!--Off-->
                <infinite_subscriptions>0</infinite_subscriptions> <!--Off-->
                <billing_frequency>0</billing_frequency> <!--Off-->
                <billing_frequency_used>0</billing_frequency_used>
            </general>
            <trial>
                <trial_status>0</trial_status> <!--Off-->
                <trial_length>15</trial_length> <!--15 days-->
                <trial_length_unit>3</trial_length_unit> <!--days-->
                <trial_start_date_type>1</trial_start_date_type> <!--Moment of purchase-->
                <trial_static_auth>1</trial_static_auth>
                <trial_static_auth_amount>1</trial_static_auth_amount>
            </trial>
            <discount>
                <offer_flat_discount_status>0</offer_flat_discount_status> <!--Off-->
                <discount_amount>10</discount_amount> <!--10%-->
                <discount_type>2</discount_type> <!--percents-->
            </discount>
        </tnw_subscriptions_product>
        <tnw_subscriptions_customer>
            <profile_actions>
                <can_hold>1</can_hold>
                <can_cancel>1</can_cancel>
                <until_canceled>1</until_canceled>
            </profile_actions>
            <profile_subscribe_limitations>
                <sallowspecific>0</sallowspecific>
            </profile_subscribe_limitations>
        </tnw_subscriptions_customer>
        <advanced>
            <modules_disable_output>
                <TNW_Subscriptions>1</TNW_Subscriptions>
            </modules_disable_output>
        </advanced>
        <carriers>
            <tnwautoship>
                <active>1</active>
                <title>Automatically choose carrier</title>
                <cheapest_name>Cheapest available</cheapest_name>
                <fastest_name>Fastest available</fastest_name>
                <sort_order>15</sort_order>
                <model>TNW\Subscriptions\Model\Carrier\Autoshipping</model>
            </tnwautoship>
        </carriers>
    </default>
</config>

<?php /* @var \TNW\Subscriptions\Block\Subscription\Summary\Products $block */ ?>
<div class="block products">
    <div class="block-title products-title">
        <strong><?= /* @noEscape */ __('Products') ?></strong>
        <?php if ($block->isShowEditLink()): ?>
            <a href="<?= /* @noEscape */ $block->getEditUrl('items')?>" class="profile__edit_button"></a>
        <?php endif;?>
    </div>
    <div class="block-content">
        <ol class="items">
            <?php foreach ($block->getItems() as $item): ?>
            <li class="item">
                <div class="product-item-photo">
                    <img class="photo image" src="<?= /* @noEscape */ $block->getImageUrl($item); ?>" />
                </div>
                <div class="product-item-details">
                    <strong class="product-item-name"><?= /* @noEscape */ $block->getName($item) ?></strong>
                    <span class="product-item-qty">(x<?= (int)$item->getQty() ?>)</span>
                    <div class="product-item-description"><?= /* @noEscape */ $block->getDescription($item) ?></div>
                    <dl class="item-options <?php if ((bool) $item->getMagentoProduct()->getData('tnw_subscr_hide_qty')): ?>
                     hidden
                     <?php endif; ?>">
                        <dt class="qty"><?= /* @noEscape */ __('Qty') ?></dt>
                        <dd><?= (int)$item->getQty() ?></dd>
                    </dl>
                    <dl class="item-options custom-attributes">
                    <?php foreach ($block->getItemOptions($item) as $option): ?>
                        <dt><?= $block->escapeHtml($option['label']) ?></dt>
                        <?php $formatedOptionValue = $block->getFormatedOptionValue($option) ?>
                        <dd>
                            <?php if (isset($formatedOptionValue['full_view'])): ?>
                                <?= /* @escapeNotVerified */ $formatedOptionValue['full_view'] ?>
                            <?php else: ?>
                                <?= /* @escapeNotVerified */ $formatedOptionValue['value'] ?>
                            <?php endif; ?>
                        </dd>
                    <?php endforeach; ?>
                    <?php foreach ($block->customAttributes($item) as $attribute): ?>
                        <dt><?= $block->escapeHtml($attribute->getDefaultFrontendLabel()) ?></dt>
                        <dd><?= $block->escapeHtml($attribute->getFrontend()->getValue($item)) ?></dd>
                    <?php endforeach; ?>
                    </dl>
                </div>
                <div class="additional">
                    <dl>
                        <dt><?= /* @noEscape */ __('Billing Frequency') ?></dt>
                        <dd><?= /* @noEscape */ $block->getBillingFrequencyLabel() ?></dd>
                        <dt><?= /* @noEscape */ __('Term') ?></dt>
                        <dd><?= /* @noEscape */ $block->getTerm() ?></dd>
                        <dt><?= /* @noEscape */ __('Start on') ?></dt>
                        <dd><?= /* @noEscape */ $block->getStartOnFormatted() ?></dd>
                        <dt><?= /* @noEscape */ __('Price') ?></dt>
                        <?php $taxAmount = (float) $item->getTaxAmount($block->getSubscriptionProfile()) ?>
                        <dd>
                            <?= /* @noEscape */ $block->formatPrice($item->getPrice() + $taxAmount) ?>
                            <?php if ($taxAmount): ?>
                                <?= /* @noEscape */ '(' .  __('Incl. Tax') . ')' ?>
                            <?php endif; ?>
                        </dd>
                    </dl>
                </div>
            </li>
            <?php endforeach; ?>
        </ol>
        <div class="product-frequency-description"><?= /* @noEscape */ $block->getFrequencyDescription() ?></div>
    </div>
</div>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="order_totals">
            <block class="TNW\Subscriptions\Block\Sales\Order\InitialFee" name="initial_fee" template="TNW_Subscriptions::order/initial_fee.phtml">
                <action method="setIsPlaneMode">
                    <argument name="value" xsi:type="string">1</argument>
                </action>
            </block>
        </referenceBlock>
        <referenceBlock name="additional.product.info">
            <block class="TNW\Subscriptions\Block\Order\Email\SubscriptionItems" name="subscription_items" template="TNW_Subscriptions::order/email/items.phtml"/>
        </referenceBlock>
        <referenceBlock name="items" template="TNW_Subscriptions::order/email/sales-items.phtml">
            <block class="TNW\Subscriptions\Block\Subscription\Billing\EmailCouponInformation"
                   name="coupon_expire" as="coupon_expire"
                   template="TNW_Subscriptions::order/email/coupon-expire.phtml"
                   after="order_totals"/>
        </referenceBlock>
    </body>
</page>

<layout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/layout_generic.xsd">
    <referenceBlock name="render.product.prices">
        <arguments>
            <argument name="default" xsi:type="array">
                <item name="prices" xsi:type="array">
                    <item name="subscription_price" xsi:type="array">
                        <item name="render_class" xsi:type="string">TNW\Subscriptions\Pricing\Render\SubscriptionPriceBox</item>
                        <item name="render_template" xsi:type="string">TNW_Subscriptions::product/price/subscription_price.phtml</item>
                        <item name="amount_render_template" xsi:type="string">TNW_Subscriptions::product/price/amount/default.phtml</item>
                        <item name="amount_render_class" xsi:type="string">TNW\Subscriptions\Pricing\Render\SubscriptionAmount</item>
                    </item>
                </item>
            </argument>
            <argument name="configurable" xsi:type="array">
                <item name="prices" xsi:type="array">
                    <item name="subscription_price" xsi:type="array">
                        <item name="render_class" xsi:type="string">TNW\Subscriptions\Pricing\Render\SubcsriptionConfigurablePriceBox</item>
                        <item name="render_template" xsi:type="string">TNW_Subscriptions::product/price/sub_configurable_price.phtml</item>
                        <item name="amount_render_template" xsi:type="string">TNW_Subscriptions::product/price/amount/default.phtml</item>
                        <item name="amount_render_class" xsi:type="string">TNW\Subscriptions\Pricing\Render\SubscriptionAmount</item>
                    </item>
                </item>
            </argument>
        </arguments>
    </referenceBlock>
</layout>

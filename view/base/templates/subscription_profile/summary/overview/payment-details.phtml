        <strong><?= __("Payment Details") ?></strong>
        <?php if ($block->isShowEditLink()): ?>
            <a href="<?= $block->getEditUrl('billing'); ?>"
               class="profile__edit_button"
               id="payment-details-edit-button">
            </a>
        <?php endif; ?>
    </div>
    <?php endif; ?>
    <div class="block-content inner-block tnw_subscriptions">
<?php endif;?>
        <table class="table-secondary data-table">
            <tbody>
            <tr class="col-0">
                <td class="label"><?= __('Payment Type') ?></td>
                <td class="right"><?= $block->getPaymentMethodTitle() ?></td>
            </tr>
            <?php if ($additionalInfo = $block->getPaymentAdditionalInfo()):?>

                        class="action primary place-on-hold">
                    <?= __('Resume') ?>
                </button>
                <span class="re-activate-comment">
                    <?= __('Resume subscription.') ?>
                </span>
            </div>
        <?php endif ?>
        <?php if ($block->isCancelActive()): ?>
            <div style="margin-top: 1%">
                <button onclick="window.location.href='<?= $block->getCancelUrl() ?>'"
                        class="action primary cancel-subscription">
                    <?= __('Cancel Subscription') ?>
                </button>
                <span class="cancel-subscription-comment">
                <?= __('Cancel the subscription. This action cannot be reversed.') ?>
                </span>

<?php /* @var TNW\Subscriptions\Block\Subscription\Summary\Overview\DangerZone $block */ ?>
<div class="block">
    <div class="block-title danger-zone">
        <strong class="danger-zone-title"><?= __("Danger Zone") ?></strong>
    </div>
    <div class="block-content">
        <?php if ($block->isPlaceOnHoldActive()): ?>
            <div>
                <button onclick="window.location.href='<?= $block->getPlaceOnHoldUrl() ?>'"

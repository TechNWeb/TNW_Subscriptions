<?xml version="1.0" ?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/tnw-subscriptions-carts/mine/shipping-methods" method="GET">
        <service class="Magento\Quote\Api\ShippingMethodManagementInterface" method="getList"/>
        <resources>
            <resource ref="self" />
        </resources>
        <data>
            <parameter name="cartId" force="true">%tnw_subscriptions_cart_id%</parameter>
        </data>
    </route>
    <route url="/V1/tnw-subscriptions-carts/mine/estimate-shipping-methods" method="POST">
        <service class="Magento\Quote\Api\ShipmentEstimationInterface" method="estimateByExtendedAddress"/>
        <resources>
            <resource ref="self" />
        </resources>
        <data>
            <parameter name="cartId" force="true">%tnw_subscriptions_cart_id%</parameter>
        </data>
    </route>
    <route url="/V1/tnw-subscriptions-carts/mine/estimate-shipping-methods-by-address-id" method="POST">
        <service class="Magento\Quote\Api\ShippingMethodManagementInterface" method="estimateByAddressId"/>
        <resources>
            <resource ref="self" />
        </resources>
        <data>
            <parameter name="cartId" force="true">%tnw_subscriptions_cart_id%</parameter>
        </data>
    </route>

    <!-- Managing My shipping information -->
    <route url="/V1/tnw-subscriptions-carts/mine/shipping-information" method="POST">
        <service class="Magento\Checkout\Api\ShippingInformationManagementInterface" method="saveAddressInformation"/>
        <resources>
            <resource ref="self" />
        </resources>
        <data>
            <parameter name="cartId" force="true">%tnw_subscriptions_cart_id%</parameter>
        </data>
    </route>

    <!-- Managing My totals information -->
    <route url="/V1/tnw-subscriptions-carts/mine/totals-information" method="POST">
        <service class="Magento\Checkout\Api\TotalsInformationManagementInterface" method="calculate"/>
        <resources>
            <resource ref="self" />
        </resources>
        <data>
            <parameter name="cartId" force="true">%tnw_subscriptions_cart_id%</parameter>
        </data>
    </route>

    <!-- Managing mine Cart Coupons -->
    <route url="/V1/tnw-subscriptions-carts/mine/coupons" method="GET">
        <service class="Magento\Quote\Api\CouponManagementInterface" method="get"/>
        <resources>
            <resource ref="self" />
        </resources>
        <data>
            <parameter name="cartId" force="true">%tnw_subscriptions_cart_id%</parameter>
        </data>
    </route>
    <route url="/V1/tnw-subscriptions-carts/mine/coupons/:couponCode" method="PUT">
        <service class="Magento\Quote\Api\CouponManagementInterface" method="set"/>
        <resources>
            <resource ref="self" />
        </resources>
        <data>
            <parameter name="cartId" force="true">%tnw_subscriptions_cart_id%</parameter>
        </data>
    </route>
    <route url="/V1/tnw-subscriptions-carts/mine/coupons" method="DELETE">
        <service class="Magento\Quote\Api\CouponManagementInterface" method="remove"/>
        <resources>
            <resource ref="self" />
        </resources>
        <data>
            <parameter name="cartId" force="true">%tnw_subscriptions_cart_id%</parameter>
        </data>
    </route>

    <!-- Checking customer's authorization status -->
    <route url="/V1/tnw-subscriptions-customer/isCustomerExistsAndShouldBeLoggedIn" method="POST">
        <service class="TNW\Subscriptions\Api\CustomerAccountCheckerInterface" method="isCustomerExistsAndShouldBeLoggedIn"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>

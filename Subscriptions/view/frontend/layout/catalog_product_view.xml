<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="product.info.addtocart" class="TNW\Subscriptions\Block\Product\View\Subscribe" template="TNW_Subscriptions::product/view/addtocart-tabs.phtml">
            <block class="TNW\Subscriptions\Block\Product\View\Subscribe" name="product.info.addtocart.subscription" as="addtocart_subscribe" template="TNW_Subscriptions::product/view/addtocart/subscribe.phtml"/>
            <block class="Magento\Catalog\Block\Product\View" name="product.info.addtocart.orig" as="addtocart_orig" template="product/view/addtocart.phtml"/>
        </referenceBlock>
        <referenceBlock name="product.info.addtocart.additional" class="TNW\Subscriptions\Block\Product\View\Subscribe" template="TNW_Subscriptions::product/view/addtocart-tabs.phtml">
            <block class="TNW\Subscriptions\Block\Product\View\Subscribe" name="product.info.addtocart.additional.subscription" as="addtocart_subscribe" template="TNW_Subscriptions::product/view/addtocart/subscribe.phtml"/>
            <block class="Magento\Catalog\Block\Product\View" name="product.info.addtocart.additional.orig" as="addtocart_orig" template="product/view/addtocart.phtml"/>
        </referenceBlock>
        <referenceContainer name="product.info.price">
            <block class="TNW\Subscriptions\Pricing\Render" name="product.subscription.price.final" before="product.price.final">
                <arguments>
                    <argument name="price_render" xsi:type="string">product.price.render.default</argument>
                    <argument name="price_type_code" xsi:type="string">subscription_price</argument>
                    <argument name="zone" xsi:type="string">item_view</argument>
                    <argument name="css_classes" xsi:type="string">subscription-price-container</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>

<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">tnw_subscriptionprofile_checkout_payment_form.tnw_subscriptionprofile_checkout_payment_form_data_source</item>
            <item name="deps" xsi:type="string">tnw_subscriptionprofile_checkout_payment_form.tnw_subscriptionprofile_checkout_payment_form_data_source</item>
        </item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="useParentLoader" xsi:type="boolean">true</item>
            <item name="parentForLoader" xsi:type="string">cart.steps</item>
            <item name="ajaxSaveType" xsi:type="string">simple</item>
            <item name="ajaxSave" xsi:type="boolean">true</item>
            <item name="component" xsi:type="string">TNW_Subscriptions/js/components/payment-form</item>
            <item name="namespace" xsi:type="string">tnw_subscriptionprofile_checkout_payment_form</item>
        </item>
        <item name="template" xsi:type="string">templates/form/subs_collapsible</item>
    </argument>
    <dataSource name="tnw_subscriptionprofile_checkout_payment_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">TNW\Subscriptions\Model\SubscriptionProfile\DataProvider\Checkout\Payment</argument>
            <argument name="name" xsi:type="string">tnw_subscriptionprofile_checkout_payment_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">payment_form_data</argument>
            <argument name="requestFieldName" xsi:type="string">payment_form_data</argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
    </dataSource>
    <fieldset name="payment_information">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="collapsible" xsi:type="boolean">false</item>
                <item name="label" xsi:type="string" translate="true">Payment Information</item>
                <item name="component" xsi:type="string">TNW_Subscriptions/js/form/subscription-profile/payment/fieldset</item>
                <item name="sortOrder" xsi:type="number">10</item>
                <item name="additionalClasses" xsi:type="string">sub-fieldset</item>
                <item name="dataScope" xsi:type="string">payment</item>
            </item>
        </argument>
    </fieldset>
</form>

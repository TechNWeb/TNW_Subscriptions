<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">tnw_subscriptionprofile_change_status_popup_form.tnw_subscriptionprofile_change_status_popup_form_data_source</item>
            <item name="deps" xsi:type="string">tnw_subscriptionprofile_change_status_popup_form.tnw_subscriptionprofile_change_status_popup_form_data_source</item>
        </item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="namespace" xsi:type="string">tnw_subscriptionprofile_change_status_popup_form</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <dataSource name="tnw_subscriptionprofile_change_status_popup_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="tnw_subscriptions/subscriptionprofile/updatestatus"/>
        </settings>
        <dataProvider class="TNW\Subscriptions\Model\SubscriptionProfile\DataProvider\Modal\ChangeStatusPopup" name="tnw_subscriptionprofile_change_status_popup_form_data_source">
            <settings>
                <primaryFieldName>change_status_popup</primaryFieldName>
                <requestFieldName>change_status_popup</requestFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label></label>
        </settings>
        <field name="suspension_text" template="TNW_Subscriptions/form/element/label" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="text" translate="true" xsi:type="string">IMPORTANT: The customer will not be billed and no orders will be created in the system while subscription profile is paused.</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <imports>
                    <link name="visible">${ $.parentName }.suspension_type:visible</link>
                </imports>
            </settings>
        </field>
        <field name="suspension_type"
               formElement="radioset"
               component="TNW_Subscriptions/js/subscription_profile/pause-radio-set"
               template="TNW_Subscriptions/form/element/checkbox-set-with-html-label">
            <argument name="data" xsi:type="array">
                <item name="multiple" xsi:type="boolean">false</item>
                <item name="options" xsi:type="object">TNW\Subscriptions\Ui\DataProvider\SubscriptionProfile\Edit\SuspendButtonPopupOptions</item>
            </argument>
            <settings>
                <visible>false</visible>
                <imports>
                    <link name="handleVisibility">${ $.provider }:data.status</link>
                </imports>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <additionalClasses>
                    <class name="admin__field-small">true</class>
                </additionalClasses>
            </settings>
        </field>
        <field name="cycles_count" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="additionalInfo" xsi:type="string" translate="true">orders/payments</item>
                </item>
            </argument>
            <settings>
                <dataScope>cycles_count</dataScope>
                <dataType>text</dataType>
                <imports>
                    <link name="visible">${ $.parentName }.suspension_type:visible</link>
                </imports>
                <additionalClasses>
                    <class name="admin__field-x-small">true</class>
                </additionalClasses>
                <labelVisible>false</labelVisible>
            </settings>
        </field>
        <field name="comment_area" formElement="textarea">
            <settings>
                <labelVisible>false</labelVisible>
                <componentType>field</componentType>
                <dataType>text</dataType>
                <placeholder>Comment</placeholder>
            </settings>
        </field>
        <field name="comment_notify" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="toggleLabels" xsi:type="array">
                        <item name="on" xsi:type="string" translate="true">Send comment to Customer</item>
                        <item name="off" xsi:type="string" translate="true">Comment for internal use only</item>
                    </item>
                    <item name="default" xsi:type="string">1</item>
                </item>
            </argument>
            <settings>
                <labelVisible>false</labelVisible>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <prefer>toggle</prefer>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
</form>

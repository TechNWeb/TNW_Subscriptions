<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="TNW\Subscriptions\Block\Cart" name="tnw_subscriptions.cart" template="TNW_Subscriptions::cart.phtml" cacheable="false">
                <container name="tnw_subscriptions.cart.items" as="with-items">
                    <container name="tnw_subscriptions.cart.container" htmlTag="div" htmlClass="cart-container" before="-">
                        <container name="cart.summary" label="Cart Summary Container" htmlTag="div" htmlClass="cart-summary" after="-">
                            <block class="Magento\Framework\View\Element\Template" name="tnw_subscriptions.cart.summary.title" before="-" template="Magento_Theme::text.phtml">
                                <arguments>
                                    <argument translate="true" name="text" xsi:type="string">Summary</argument>
                                    <argument name="tag" xsi:type="string">strong</argument>
                                    <argument name="css_class" xsi:type="string">summary title</argument>
                                </arguments>
                            </block>
                            <block class="TNW\Subscriptions\Block\Cart" name="tnw_subscriptions.cart.methods.bottom" template="TNW_Subscriptions::cart/methods.phtml">
                                <container name="tnw_subscriptions.cart.methods" as="methods">
                                    <block class="TNW\Subscriptions\Block\Checkout\Link" name="tnw_subscriptions.cart.methods.checkout.bottom" template="TNW_Subscriptions::checkout/link.phtml" />
                                </container>
                            </block>
                        </container>
                        <block class="TNW\Subscriptions\Block\Cart\Profile" name="tnw_subscriptions.cart.form" as="cart-items" template="TNW_Subscriptions::cart/form.phtml" after="cart.summary" />
                    </container>
                </container>
                <container name="tnw_subscriptions.cart.noitems" as="no-items">
                    <block class="TNW\Subscriptions\Block\Cart" name="tnw_subscriptions.cart.empty" before="-" template="TNW_Subscriptions::cart/noItems.phtml" />
                </container>
            </block>
        </referenceContainer>
    </body>
</page>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="category.products.list">
            <arguments>
                <argument name="customerProductsHistoryList" xsi:type="object">
                    TNW\Subscriptions\Block\Product\CustomerProductsHistoryList
                </argument>
            </arguments>

            <action method="setTemplate">
                <argument name="template" xsi:type="string">TNW_Subscriptions::product/list.phtml</argument>
            </action>

            <block class="TNW\Subscriptions\Block\Product\ListProduct"
                   name="helper.category.products.list"
                   as="helper.category.products.list"/>
        </referenceBlock>

    </body>
</page>

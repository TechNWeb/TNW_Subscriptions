<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">tnw_subscriptionprofile_cancel_button_popup_form.tnw_subscriptionprofile_cancel_button_popup_form_data_source</item>
            <item name="deps" xsi:type="string">tnw_subscriptionprofile_cancel_button_popup_form.tnw_subscriptionprofile_cancel_button_popup_form_data_source</item>
        </item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="namespace" xsi:type="string">tnw_subscriptionprofile_cancel_button_popup_form</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <dataSource name="tnw_subscriptionprofile_cancel_button_popup_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">TNW\Subscriptions\Model\SubscriptionProfile\DataProvider\Modal\CancelButtonPopup</argument>
            <argument name="name" xsi:type="string">tnw_subscriptionprofile_cancel_button_popup_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">tnw_subscriptionprofile_cancel_button_popup_form</argument>
            <argument name="requestFieldName" xsi:type="string">namespace</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="submit_url" path="tnw_subscriptions/subscriptionprofile/cancelsubscription" xsi:type="url"/>
                </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="submit_url" path="tnw_subscriptions/subscriptionprofile/cancelsubscription" xsi:type="url"/>
            </item>
        </argument>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label></label>
        </settings>
        <field name="cancel_button_popup_title">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="template" xsi:type="string">TNW_Subscriptions/form/element/label</item>
                    <item name="text" translate="true" xsi:type="string">If subscription is canceled effective immediately, no partial refunds will be issued.</item>
                </item>
            </argument>
        </field>
        <field name="cancel_button_popup_options">
            <argument name="data" xsi:type="array">
                <item name="multiple" xsi:type="boolean">false</item>
                <item name="options" xsi:type="object">TNW\Subscriptions\Ui\DataProvider\SubscriptionProfile\Edit\CancelButtonPopupOptions</item>
                <item name="config" xsi:type="array">
                    <item name="additionalClasses" xsi:type="string">admin__field-wide</item>
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="formElement" xsi:type="string">radioset</item>
                    <item name="template" xsi:type="string">TNW_Subscriptions/form/element/checkbox-set-with-html-label</item>
                    <item name="validation" xsi:type="array">
                        <item name="required-entry" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </field>
        <field name="comment_area" formElement="textarea">
            <settings>
                <labelVisible>false</labelVisible>
                <componentType>field</componentType>
                <dataType>text</dataType>
                <placeholder>Comment</placeholder>
            </settings>
        </field>
        <field name="comment_notify" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="toggleLabels" xsi:type="array">
                        <item name="on" xsi:type="string" translate="true">Send comment to Customer</item>
                        <item name="off" xsi:type="string" translate="true">Comment for internal use only</item>
                    </item>
                    <item name="default" xsi:type="string">1</item>
                    <item name="additionalInfo" xsi:type="string" translate="true">Notification disable in configuration</item>
                    <item name="label"
                </item>
            </argument>
            <settings>
                <labelVisible>false</labelVisible>
                <additionalInfoVisible>false</additionalInfoVisible>
                <imports>
                    <link name="disabled">${ $.provider}:data.disableCheckbox</link>
                </imports>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <prefer>toggle</prefer>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
</form>
